d: var(--glass);\r\n  border: 1px solid var(--border); border-radius: var(--r-lg);\r\n  padding: 24px; display: flex; flex-direction: column; gap: 14px;\r\n  position: relative; overflow: hidden;\r\n  transition: transform .35s cubic-bezier(.2,.8,.25,1), box-shadow .35s;\r\n}\r\n.testi-card:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(0,0,0,.4); }\r\n\r\n/* Accent left border by variant */\r\n.testi-card.tc-0 { background: linear-gradient(145deg, rgba(4, 18, 14, 0.95), var(--glass)); }\r\n.testi-card.tc-0::before { content: ''; position: absolute; top: 0; left: 0; bottom: 0; width: 3.5px; background: linear-gradient(180deg, #10B981, #06B6D4); border-radius: 2px 0 0 2px; }\r\n.testi-card.tc-0:hover { border-color: rgba(16,185,129,.28) !important; box-shadow: 0 20px 50px rgba(0,0,0,.4), 0 0 28px rgba(16,185,129,.08); }\r\n.testi-card.tc-1 { background: linear-gradient(145deg, rgba(18, 8, 32, 0.95), var(--glass)); }\r\n.testi-card.tc-1::before { content: ''; position: absolute; top: 0; left: 0; bottom: 0; width: 3.5px; background: linear-gradient(180deg, #A855F7, #EC4899); border-radius: 2px 0 0 2px; }\r\n.testi-card.tc-1:hover { border-color: rgba(168,85,247,.28) !important; box-shadow: 0 20px 50px rgba(0,0,0,.4), 0 0 28px rgba(124,58,237,.1); }\r\n.testi-card.tc-2 { background: linear-gradient(145deg, rgba(25, 14, 4, 0.95), var(--glass)); }\r\n.testi-card.tc-2::before { content: ''; position: absolute; top: 0; left: 0; bottom: 0; width: 3.5px; background: linear-gradient(180deg, #F59E0B, #E11D48); border-radius: 2px 0 0 2px; }\r\n.testi-card.tc-2:hover { border-color: rgba(245,158,11,.28) !important; box-shadow: 0 20px 50px rgba(0,0,0,.4), 0 0 28px rgba(245,158,11,.08); }\r\n\r\n.tc-quote-mark {\r\n  position: absolute; top: -10px; right: 14px;\r\n  font-size: 80px; font-family: var(--serif); color: rgba(37,99,235,.08);\r\n  line-height: 1; pointer-events: none; user-select: none;\r\n}\r\n.testi-card:nth-child(1) .tc-quote-mark { font-size: 120px; }\r\n\r\n.tc-stars { display: flex; gap: 3px; }\r\n.star-icon { width: 13px; fill: #F59E0B; }\r\n.tc-text { color: var(--text-2); font-size: 14px; line-height: 1.72; flex: 1; position: relative; z-index: 1; }\r\n.testi-card:nth-child(1) .tc-text { font-size: 15px; }\r\n\r\n.tc-author { display: flex; align-items: center; gap: 11px; }\r\n.tc-avatar {\r\n  width: 42px; aspect-ratio: 1; border-radius: 50%; flex-shrink: 0;\r\n  display: grid; place-items: center; font: 600 13px var(--sans); color: #fff;\r\n}\r\n.testi-card.tc-0 .tc-avatar { background: linear-gradient(135deg, #059669, #0284c7); box-shadow: 0 0 12px rgba(16, 185, 129, 0.35); }\r\n.testi-card.tc-1 .tc-avatar { background: linear-gradient(135deg, #7c3aed, #db2777); box-shadow: 0 0 12px rgba(168, 85, 247, 0.35); }\r\n.testi-card.tc-2 .tc-avatar { background: linear-gradient(135deg, #d97706, #e11d48); box-shadow: 0 0 12px rgba(245, 158, 11, 0.35); }\r\n.tc-author strong { display: block; font-size: 13px; font-weight: 600; }\r\n.tc-author span   { font: 10px var(--mono); color: var(--text-3); letter-spacing: .05em; display: block; margin-top: 2px; }\r\n\r\n.testi-cta { margin-top: 24px; display: flex; justify-content: center; }\r\n\r\n/* ══════════════════════════════════════════════════════════════\r\n   VIDEOS SECTION\r\n   ══════════════════════════════════════════════════════════════ */\r\n.videos-section { padding: var(--py) var(--px); border-top: 1px solid var(--border); }\r\n.videos-header { margin-bottom: 26px; }\r\n.videos-header h2 { margin: 8px 0 16px; }\r\n.videos-header > p { color: var(--text-2); font-size: 15px; line-height: 1.68; max-width: 440px; }\r\n.video-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }\r\n\r\n.vid-card {\r\n  background: var(--glass);\r\n  border: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden;\r\n  display: flex; flex-direction: column;\r\n  transition: transform .35s cubic-bezier(.2,.8,.25,1), box-shadow .35s, border-color .35s;\r\n}\r\n.vid-card:hover { transform: translateY(-7px); border-color: rgba(96, 165, 250, 0.38); box-shadow: 0 24px 60px rgba(0,0,0,.55), 0 0 30px rgba(37, 99, 235, 0.2); }\r\n\r\n.vid-thumb { position: relative; aspect-ratio: 16/9; overflow: hidden; }\r\n.vid-art::after {\r\n  content: ''; position: absolute; inset: 0;\r\n  background: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 400 140' xmlns='http://www.w3.org/2000/svg'%3E%3Cpolyline points='0,110 40,82 80,98 120,52 160,68 200,22 240,40 280,12 320,30 360,6 400,18' fill='none' stroke='%233B82F6' stroke-width='2' stroke-opacity='.4'/%3E%3C/svg%3E\") center/contain no-repeat;\r\n}\r\n.vid-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(3,6,15,.92) 0%, rgba(3,6,15,.45) 40%, transparent 70%); }\r\n\r\n/* Real YouTube thumbnail image */\r\n.vid-yt-thumb {\r\n  position: absolute;\r\n  inset: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  display: block;\r\n  transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);\r\n}\r\n.vid-card:hover .vid-yt-thumb {\r\n  transform: scale(1.04);\r\n}\r\n\r\n.vid-play {\r\n  position: absolute;\r\n  inset: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  z-index: 3;\r\n}\r\n.vid-play::before {\r\n  content: '';\r\n  position: absolute;\r\n  width: 54px;\r\n  height: 54px;\r\n  border-radius: 50%;\r\n  background: rgba(37, 99, 235, 0.88);\r\n  border: 1.5px solid rgba(96, 165, 250, 0.45);\r\n  box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.6);\r\n  transition: transform 0.35s cubic-bezier(0.2, 0.85, 0.3, 1), background 0.35s, box-shadow 0.35s;\r\n}\r\n.vid-play svg { width: 18px; fill: #fff; stroke: none; position: relative; z-index: 1; margin-left: 3px; }\r\n.vid-card:hover .vid-play::before {\r\n  transform: scale(1.16);\r\n  background: #2563eb;\r\n  box-shadow: 0 0 0 12px rgba(37, 99, 235, 0.15), 0 0 36px rgba(37, 99, 235, 0.85);\r\n}\r\n\r\n/* YouTube badge chip (bottom-left) */\r\n.vid-yt-badge {\r\n  position: absolute;\r\n  bottom: 8px;\r\n  left: 8px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n  background: rgba(0, 0, 0, 0.72);\r\n  color: #fff;\r\n  font: 700 9px var(--mono);\r\n  letter-spacing: 0.1em;\r\n  padding: 4px 9px;\r\n  border-radius: 4px;\r\n  z-index: 4;\r\n  backdrop-filter: blur(6px);\r\n  border: 1px solid rgba(255, 255, 255, 0.1);\r\n}\r\n.vid-yt-badge svg { flex-shrink: 0; color: #FF0000; }\r\n\r\n/* Channel label in card footer */\r\n.vid-yt-channel {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n  font: 10px var(--mono);\r\n  color: var(--text-3);\r\n  letter-spacing: 0.05em;\r\n}\r\n\r\n\r\n.vid-dur { position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,.75); color: #fff; font: 10px var(--mono); padding: 3px 7px; border-radius: 4px; }\r\n/* ── Topic Tag Badge — Premium Glassmorphic Pill ── */\r\n.vid-tag {\r\n  position: absolute;\r\n  top: 10px;\r\n  right: 10px;\r\n  color: #e0f2fe;\r\n  font: 700 9px var(--mono);\r\n  letter-spacing: 0.14em;\r\n  text-transform: uppercase;\r\n  padding: 5px 11px;\r\n  border-radius: 999px;\r\n  background: linear-gradient(135deg, rgba(37, 99, 235, 0.92) 0%, rgba(14, 165, 233, 0.88) 100%);\r\n  border: 1px solid rgba(147, 197, 253, 0.45);\r\n  box-shadow:\r\n    0 0 0 1px rgba(37, 99, 235, 0.2),\r\n    0 4px 16px rgba(37, 99, 235, 0.5),\r\n    inset 0 1px 0 rgba(255, 255, 255, 0.28);\r\n  backdrop-filter: blur(10px);\r\n  -webkit-backdrop-filter: blur(10px);\r\n  z-index: 4;\r\n  white-space: nowrap;\r\n  transition: box-shadow 0.3s ease, transform 0.3s ease;\r\n}\r\n.vid-card:hover .vid-tag {\r\n  box-shadow:\r\n    0 0 0 1px rgba(56, 189, 248, 0.35),\r\n    0 6px 22px rgba(37, 99, 235, 0.75),\r\n    inset 0 1px 0 rgba(255, 255, 255, 0.35);\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.vid-info { padding: 18px; flex: 1; display: flex; flex-direction: column; gap: 10px; }\r\n.vid-info h3 { font-size: 14.5px; font-weight: 700; letter-spacing: -.02em; line-height: 1.35; }\r\n.vid-info > p { color: var(--text-2); font-size: 13px; line-height: 1.65; flex: 1; }\r\n.vid-foot { display: flex; align-items: center; justify-content: space-between; padding-top: 14px; border-top: 1px solid var(--border); }\r\n.vid-foot > span { font: 10px var(--mono); color: var(--text-3); }\r\n\r\n/* ── Watch on YouTube — Premium Pill Button ── */\r\n.vid-link {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n  padding: 7px 14px;\r\n  font: 700 11px var(--mono);\r\n  letter-spacing: 0.06em;\r\n  color: #fff;\r\n  background: linear-gradient(135deg, rgba(37, 99, 235, 0.85) 0%, rgba(14, 165, 233, 0.8) 100%);\r\n  border: 1px solid rgba(147, 197, 253, 0.35);\r\n  border-radius: 999px;\r\n  text-decoration: none;\r\n  position: relative;\r\n  overflow: hidden;\r\n  transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.28s, background 0.28s;\r\n  box-shadow: 0 3px 14px rgba(37, 99, 235, 0.38), inset 0 1px 0 rgba(255,255,255,0.18);\r\n}\r\n.vid-link::before {\r\n  content: '';\r\n  position: absolute;\r\n  inset: 0;\r\n  background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.18) 50%, transparent 100%);\r\n  transform: translateX(-100%);\r\n  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);\r\n}\r\n.vid-link:hover::before {\r\n  transform: translateX(100%);\r\n}\r\n.vid-link:hover {\r\n  transform: translateY(-2px);\r\n  background: linear-gradient(135deg, rgba(37, 99, 235, 1) 0%, rgba(14, 165, 233, 1) 100%);\r\n  box-shadow: 0 8px 24px rgba(37, 99, 235, 0.6), inset 0 1px 0 rgba(255,255,255,0.25);\r\n  color: #fff;\r\n  gap: 9px;\r\n}\r\n.vid-link svg {\r\n  width: 12px;\r\n  fill: none;\r\n  stroke: currentColor;\r\n  stroke-width: 2.2;\r\n  stroke-linecap: round;\r\n  stroke-linejoin: round;\r\n  transition: transform 0.25s ease;\r\n}\r\n.vid-link:hover svg { transform: translateX(2px); }\r\n\r\n/* ── YouTube Crimson Luxury Button ── */\r\n.videos-yt-cta {\r\n  margin-top: 36px;\r\n  display: flex;\r\n  justify-content: center;\r\n}\r\n\r\n/* ── YouTube Subscribe CTA — Ultra Premium Crimson ── */\r\n#yt-btn,\r\n.yt-subscribe-btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 14px;\r\n  padding: 15px 34px 15px 24px;\r\n  font-size: 15px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.01em;\r\n  color: #ffffff !important;\r\n  background: linear-gradient(165deg, #E52222 0%, #CC0000 45%, #A80000 100%) !important;\r\n  border: 1px solid rgba(255, 255, 255, 0.18) !important;\r\n  border-top: 1.5px solid rgba(255, 255, 255, 0.55) !important;\r\n  border-radius: 999px;\r\n  cursor: pointer;\r\n  position: relative;\r\n  overflow: hidden;\r\n  text-decoration: none;\r\n  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);\r\n  box-shadow:\r\n    0 0 0 1px rgba(180, 0, 0, 0.4),\r\n    0 10px 30px -4px rgba(180, 0, 0, 0.75),\r\n    0 4px 10px rgba(0, 0, 0, 0.5),\r\n    inset 0 1.5px 0 rgba(255, 255, 255, 0.4),\r\n    inset 0 -2px 0 rgba(0, 0, 0, 0.35) !important;\r\n  transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.32s, background 0.32s !important;\r\n}\r\n\r\n/* Continuous shine sweep */\r\n@keyframes yt-shine-sweep {\r\n  0%   { transform: translateX(-180%) skewX(-22deg); opacity: 0; }\r\n  12%  { opacity: 0.8; }\r\n  40%  { transform: translateX(260%) skewX(-22deg); opacity: 0; }\r\n  100% { transform: translateX(260%) skewX(-22deg); opacity: 0; }\r\n}\r\n\r\n#yt-btn::before,\r\n.yt-subscribe-btn::before {\r\n  content: '';\r\n  position: absolute;\r\n  top: -60%;\r\n  left: 0;\r\n  width: 42%;\r\n  height: 220%;\r\n  background: linear-gradient(\r\n    90deg,\r\n    transparent 0%,\r\n    rgba(255,255,255,0.06) 18%,\r\n    rgba(255,255,255,0.7) 50%,\r\n    rgba(255,255,255,0.06) 82%,\r\n    transparent 100%\r\n  );\r\n  transform: translateX(-180%) skewX(-22deg);\r\n  animation: yt-shine-sweep 3.8s cubic-bezier(0.25, 1, 0.5, 1) infinite;\r\n  pointer-events: none;\r\n  z-index: 2;\r\n}\r\n\r\n/* Warm ambient outer glow ring */\r\n#yt-btn::after,\r\n.yt-subscribe-btn::after {\r\n  content: '';\r\n  position: absolute;\r\n  inset: -2px;\r\n  border-radius: 999px;\r\n  background: transparent;\r\n  border: 1.5px solid rgba(255, 100, 100, 0.22);\r\n  pointer-events: none;\r\n  transition: border-color 0.3s ease, opacity 0.3s ease;\r\n  opacity: 0;\r\n}\r\n\r\n#yt-btn:hover::before,\r\n.yt-subscribe-btn:hover::before {\r\n  animation: none;\r\n  transform: translateX(260%) skewX(-22deg);\r\n  opacity: 0;\r\n  transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);\r\n}\r\n\r\n#yt-btn:hover::after,\r\n.yt-subscribe-btn:hover::after {\r\n  border-color: rgba(255, 100, 100, 0.55);\r\n  opacity: 1;\r\n}\r\n\r\n#yt-btn:hover,\r\n.yt-subscribe-btn:hover {\r\n  transform: translateY(-3px) scale(1.015);\r\n  background: linear-gradient(165deg, #FF3030 0%, #E00000 45%, #BF0000 100%) !important;\r\n  border-top-color: rgba(255, 255, 255, 0.7) !important;\r\n  box-shadow:\r\n    0 0 0 1px rgba(200, 0, 0, 0.5),\r\n    0 16px 40px -6px rgba(200, 0, 0, 0.85),\r\n    0 6px 16px rgba(0, 0, 0, 0.55),\r\n    inset 0 1.5px 0 rgba(255, 255, 255, 0.5),\r\n    inset 0 -2px 0 rgba(0, 0, 0, 0.38) !important;\r\n  color: #ffffff !important;\r\n}\r\n\r\n#yt-btn:active,\r\n.yt-subscribe-btn:active {\r\n  transform: translateY(0) scale(0.98);\r\n  box-shadow:\r\n    0 0 0 1px rgba(180, 0, 0, 0.4),\r\n    0 4px 12px rgba(0, 0, 0, 0.45),\r\n    inset 0 1px 0 rgba(255, 255, 255, 0.3),\r\n    inset 0 -1px 0 rgba(0, 0, 0, 0.4) !important;\r\n}\r\n\r\n.yt-btn-icon-pill {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 28px;\r\n  height: 28px;\r\n  border-radius: 8px;\r\n  background: #ffffff;\r\n  box-shadow: 0 2px 8px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.9);\r\n  flex-shrink: 0;\r\n  transition: transform 0.28s ease;\r\n}\r\n\r\n#yt-btn:hover .yt-btn-icon-pill,\r\n.yt-subscribe-btn:hover .yt-btn-icon-pill {\r\n  transform: scale(1.1);\r\n}\r\n\r\n.yt-play-triangle {\r\n  width: 13px;\r\n  height: 13px;\r\n  fill: #CC0000 !important;\r\n  stroke: none !important;\r\n  margin-left: 2px;\r\n}\r\n\r\n.yt-btn-text {\r\n  color: #ffffff;\r\n  font-size: 15px;\r\n}\r\n\r\n#yt-btn svg:not(.yt-play-triangle),\r\n.yt-subscribe-btn svg:not(.yt-play-triangle) {\r\n  width: 15px;\r\n  fill: none;\r\n  stroke: #ffffff;\r\n  stroke-width: 2.5;\r\n  stroke-linecap: round;\r\n  stroke-linejoin: round;\r\n  transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);\r\n}\r\n\r\n#yt-btn:hover svg:not(.yt-play-triangle),\r\n.yt-subscribe-btn:hover svg:not(.yt-play-triple) {\r\n  transform: translateX(4px);\r\n}\r\n\r\n/* ══════════════════════════════════════════════════════════════\r\n   FAQ — Clean accordion with numbered labels\r\n   ══════════════════════════════════════════════════════════════ */\r\n.faq-section {\r\n  padding: var(--py) var(--px);\r\n  display: grid; grid-template-columns: 1fr 1.3fr;\r\n  gap: clamp(40px, 8vw, 100px); align-items: start;\r\n}\r\n.faq-head h2 { margin-top: 10px; }\r\n.faq-list { border-top: 1px solid var(--border); }\r\n.faq-item { border-bottom: 1px solid var(--border); }\r\n.faq-item button {\r\n  width: 100%; display: flex; align-items: flex-start; gap: 14px;\r\n  padding: 20px 0; color: var(--text); text-align: left; cursor: pointer;\r\n  transition: color .2s;\r\n}\r\n.faq-item button:hover { color: var(--blue-lt); }\r\n.faq-q-num  { font: 9px var(--mono); color: var(--blue-mid); margin-top: 3px; flex-shrink: 0; }\r\n.faq-q-text { flex: 1; font-size: 14px; font-weight: 500; line-height: 1.5; }\r\n.faq-toggle { font-size: 20px; font-weight: 300; color: var(--blue-mid); flex-shrink: 0; line-height: 1; margin-top: 1px; }\r\n.faq-answer { max-height: 0; overflow: hidden; transition: max-height .35s ease; }\r\n.faq-answer.open { max-height: 280px; }\r\n.faq-answer p { font-size: 14px; line-height: 1.74; color: var(--text-2); padding: 0 0 20px calc(9px + 14px); }\r\n.faq-item.active button { color: var(--blue-lt); }\r\n.faq-item:hover button { color: var(--blue-lt); }\r\n\r\n/* ══════════════════════════════════════════════════════════════\r\n   CONTACT SECTION — Balanced Institutional Desk & Direct Enquiry Form\r\n   ══════════════════════════════════════════════════════════════ */\r\n.contact-section {\r\n  position: relative;\r\n  background-color: var(--bg-2);\r\n  background-image: \r\n    radial-gradient(ellipse 65% 50% at 85% 15%, rgba(37, 99, 235, 0.1) 0%, transparent 60%),\r\n    radial-gradient(ellipse 55% 45% at 15% 85%, rgba(16, 185, 129, 0.07) 0%, transparent 55%),\r\n    linear-gradient(to bottom, rgba(6, 13, 30, 0.6) 0%, rgba(3, 6, 15, 0.95) 100%);\r\n  border-top: 1px solid rgba(255, 255, 255, 0.07);\r\n  display: grid;\r\n  grid-template-columns: 1fr 1.05fr;\r\n  gap: clamp(32px, 5vw, 56px);\r\n  padding: var(--py) var(--px);\r\n  align-items: stretch;\r\n}\r\n\r\n/* Subtle grid texture in background */\r\n.contact-section::before {\r\n  content: '';\r\n  position: absolute;\r\n  inset: 0;\r\n  background-image: \r\n    linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),\r\n    linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px);\r\n  background-size: 40px 40px;\r\n  pointer-events: none;\r\n  opacity: 0.6;\r\n}\r\n\r\n/* ── Left Column: Direct Communication Channels ────────────── */\r\n.contact-desk-column {\r\n  position: relative;\r\n  z-index: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: space-between;\r\n  height: 100%;\r\n}\r\n\r\n.contact-desk-intro h2 {\r\n  margin: 10px 0 14px;\r\n  font-size: clamp(34px, 3.8vw, 54px);\r\n  line-height: 1.04;\r\n}\r\n\r\n.contact-desk-lead {\r\n  color: var(--text-2);\r\n  font-size: 15px;\r\n  line-height: 1.7;\r\n  max-width: 440px;\r\n  margin: 0;\r\n}\r\n\r\n/* 3 Balanced Channel Cards */\r\n.contact-channels-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  margin-top: 20px;\r\n  flex: 1;\r\n  justify-content: space-between;\r\n}\r\n\r\n.channel-card {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 15px;\r\n  padding: 14px 18px;\r\n  border-radius: var(--r-lg);\r\n  background: linear-gradient(135deg, rgba(11, 24, 52, 0.8) 0%, rgba(6, 14, 32, 0.9) 100%);\r\n  border: 1px solid rgba(255, 255, 255, 0.09);\r\n  text-decoration: none;\r\n  color: var(--text);\r\n  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);\r\n  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.28);\r\n  position: relative;\r\n  overflow: hidden;\r\n  flex: 1;\r\n}\r\n\r\n.channel-card::before {\r\n  content: '';\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  bottom: 0;\r\n  width: 3px;\r\n  background: transparent;\r\n  transition: background 0.25s;\r\n}\r\n\r\n.channel-card:hover {\r\n  transform: translateY(-2px);\r\n  color: #fff;\r\n}\r\n\r\n/* Card: WhatsApp */\r\n.card-whatsapp:hover {\r\n  border-color: rgba(16, 185, 129, 0.45);\r\n  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4), 0 0 20px rgba(16, 185, 129, 0.14);\r\n  background: linear-gradient(135deg, rgba(14, 32, 60, 0.95) 0%, rgba(7, 18, 40, 0.96) 100%);\r\n}\r\n.card-whatsapp::before {\r\n  background: #10b981;\r\n}\r\n\r\n/* Card: Email */\r\n.card-email:hover {\r\n  border-color: rgba(124, 58, 237, 0.45);\r\n  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4), 0 0 20px rgba(124, 58, 237, 0.14);\r\n  background: linear-gradient(135deg, rgba(18, 30, 68, 0.95) 0%, rgba(8, 16, 44, 0.96) 100%);\r\n}\r\n.card-email::before {\r\n  background: #818cf8;\r\n}\r\n\r\n.channel-icon-box {\r\n  width: 42px;\r\n  height: 42px;\r\n  border-radius: 10px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex-shrink: 0;\r\n  transition: transform 0.25s ease;\r\n}\r\n\r\n.card-whatsapp .channel-icon-box {\r\n  background: rgba(16, 185, 129, 0.15);\r\n  color: #34d399;\r\n  border: 1px solid rgba(16, 185, 129, 0.35);\r\n}\r\n\r\n.card-email .channel-icon-box {\r\n  background: rgba(124, 58, 237, 0.16);\r\n  color: #a78bfa;\r\n  border: 1px solid rgba(124, 58, 237, 0.35);\r\n}\r\n\r\n.channel-card:hover .channel-icon-box {\r\n  transform: scale(1.06);\r\n}\r\n\r\n.channel-info {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n\r\n.channel-meta {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.channel-badge {\r\n  font: 700 8.5px/1 var(--mono);\r\n  letter-spacing: 0.12em;\r\n  padding: 2px 6px;\r\n  border-radius: 4px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.badge-emerald {\r\n  background: rgba(16, 185, 129, 0.16);\r\n  color: #34d399;\r\n  border: 1px solid rgba(16, 185, 129, 0.3);\r\n}\r\n\r\n.badge-blue {\r\n  background: rgba(56, 189, 248, 0.15);\r\n  color: #38bdf8;\r\n  border: 1px solid rgba(56, 189, 248, 0.3);\r\n}\r\n\r\n.badge-indigo {\r\n  background: rgba(124, 58, 237, 0.16);\r\n  color: #c4b5fd;\r\n  border: 1px solid rgba(124, 58, 237, 0.3);\r\n}\r\n\r\n.channel-title {\r\n  font: 700 10.5px var(--mono);\r\n  letter-spacing: 0.08em;\r\n  color: var(--text-3);\r\n  text-transform: uppercase;\r\n}\r\n\r\n.channel-value {\r\n  font: 700 14.5px/1.3 var(--sans);\r\n  color: #fff;\r\n  letter-spacing: 0.01em;\r\n  word-break: break-all;\r\n}\r\n\r\n.channel-value.email-link {\r\n  color: #fff;\r\n  transition: color 0.2s;\r\n}\r\n\r\n.channel-value.email-link:hover {\r\n  color: #38bdf8;\r\n}\r\n\r\n.channel-subtext {\r\n  font-size: 11.5px;\r\n  color: var(--text-2);\r\n  line-height: 1.4;\r\n}\r\n\r\n.channel-arrow {\r\n  width: 30px;\r\n  height: 30px;\r\n  border-radius: 8px;\r\n  background: rgba(255, 255, 255, 0.04);\r\n  border: 1px solid rgba(255, 255, 255, 0.08);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: var(--text-3);\r\n  flex-shrink: 0;\r\n  transition: all 0.25s ease;\r\n}\r\n\r\n.channel-arrow svg {\r\n  width: 14px;\r\n  height: 14px;\r\n  stroke: currentColor;\r\n  fill: none;\r\n  stroke-width: 2;\r\n  stroke-linecap: round;\r\n  stroke-linejoin: round;\r\n}\r\n\r\n.channel-card:hover .channel-arrow {\r\n  background: rgba(56, 189, 248, 0.15);\r\n  border-color: rgba(56, 189, 248, 0.35);\r\n  color: #38bdf8;\r\n  transform: translateX(3px);\r\n}\r\n\r\n.channel-action-group {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.channel-copy-btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n  padding: 6px 11px;\r\n  border-radius: 6px;\r\n  background: rgba(255, 255, 255, 0.06);\r\n  border: 1px solid rgba(255, 255, 255, 0.12);\r\n  font: 600 11px var(--mono);\r\n  color: var(--text-2);\r\n  cursor: pointer;\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.channel-copy-btn:hover {\r\n  background: rgba(255, 255, 255, 0.12);\r\n  color: #fff;\r\n  border-color: rgba(255, 255, 255, 0.25);\r\n}\r\n\r\n.channel-copy-btn.copied {\r\n  background: rgba(16, 185, 129, 0.2);\r\n  border-color: rgba(16, 185, 129, 0.5);\r\n  color: #34d399;\r\n}\r\n\r\n.channel-mail-arrow {\r\n  width: 30px;\r\n  height: 30px;\r\n  border-radius: 6px;\r\n  background: rgba(255, 255, 255, 0.04);\r\n  border: 1px solid rgba(255, 255, 255, 0.08);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: var(--text-3);\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.channel-mail-arrow:hover {\r\n  background: rgba(124, 58, 237, 0.2);\r\n  border-color: rgba(124, 58, 237, 0.4);\r\n  color: #c4b5fd;\r\n}\r\n\r\n/* ── Right Column: Balanced Form Card ───────────────────────── */\r\n.contact-form-card {\r\n  position: relative;\r\n  z-index: 1;\r\n  background: linear-gradient(155deg, rgba(13, 26, 54, 0.88) 0%, rgba(6, 13, 30, 0.96) 100%);\r\n  border: 1px solid rgba(56, 189, 248, 0.24);\r\n  border-radius: var(--r-lg);\r\n  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.55), 0 0 30px rgba(37, 99, 235, 0.1);\r\n  overflow: hidden;\r\n  backdrop-filter: blur(20px);\r\n  -webkit-backdrop-filter: blur(20px);\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: space-between;\r\n  height: 100%;\r\n  padding: 24px 26px;\r\n}\r\n\r\n.contact-card-head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  margin-bottom: 16px;\r\n  padding-bottom: 14px;\r\n  border-bottom: 1px solid rgba(255, 255, 255, 0.07);\r\n}\r\n\r\n.cch-title-wrap {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.cch-dot {\r\n  width: 7px;\r\n  height: 7px;\r\n  border-radius: 50%;\r\n  background: #10b981;\r\n  box-shadow: 0 0 8px #10b981;\r\n}\r\n\r\n.contact-card-head h3 {\r\n  font-size: 15.5px;\r\n  font-weight: 700;\r\n  color: #fff;\r\n  margin: 0;\r\n  letter-spacing: 0.01em;\r\n}\r\n\r\n.cch-badge {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  font: 700 9.5px/1 var(--mono);\r\n  letter-spacing: 0.1em;\r\n  color: #38bdf8;\r\n  background: rgba(56, 189, 248, 0.1);\r\n  border: 1px solid rgba(56, 189, 248, 0.25);\r\n  padding: 3px 8px;\r\n  border-radius: 4px;\r\n}\r\n\r\n.contact-actual-form {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 13px;\r\n  flex: 1;\r\n  justify-content: space-between;\r\n}\r\n\r\n/* 2-Column Row for Form Fields */\r\n.contact-form-row {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 12px;\r\n}\r\n\r\n.terminal-input-wrap {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 5px;\r\n}\r\n\r\n.terminal-input-wrap label {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  font: 700 9.5px var(--mono);\r\n  letter-spacing: 0.12em;\r\n  color: var(--text-3);\r\n  text-transform: uppercase;\r\n}\r\n\r\n.input-icon-shell {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n  width: 100%;\r\n}\r\n\r\n.input-glyph {\r\n  position: absolute;\r\n  left: 12px;\r\n  color: var(--text-3);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  pointer-events: none;\r\n  transition: color 0.2s ease;\r\n  z-index: 2;\r\n}\r\n\r\n.input-icon-shell input {\r\n  width: 100%;\r\n  color: #fff;\r\n  background: rgba(6, 15, 34, 0.88);\r\n  border: 1px solid rgba(255, 255, 255, 0.1);\r\n  padding: 10.5px 34px 10.5px 36px;\r\n  border-radius: var(--r-sm);\r\n  outline: none;\r\n  font: 13.5px/1.3 var(--sans);\r\n  transition: border-color 0.25s, box-shadow 0.25s, background 0.25s;\r\n}\r\n\r\n.input-icon-shell input:focus {\r\n  border-color: #38bdf8;\r\n  background: rgba(8, 20, 44, 0.98);\r\n  box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.18), 0 0 16px rgba(56, 189, 248, 0.12);\r\n}\r\n\r\n.input-icon-shell:focus-within .input-glyph {\r\n  color: #38bdf8;\r\n}\r\n\r\n.input-valid-check {\r\n  position: absolute;\r\n  right: 12px;\r\n  color: #10b981;\r\n  font-weight: 700;\r\n  font-size: 13px;\r\n  pointer-events: none;\r\n}\r\n\r\n.input-icon-shell input.is-invalid {\r\n  border-color: #f43f5e !important;\r\n  background: rgba(244, 63, 94, 0.06) !important;\r\n  box-shadow: 0 0 0 3px rgba(244, 63, 94, 0.18) !important;\r\n}\r\n\r\n.input-icon-shell input.is-valid {\r\n  border-color: rgba(56, 189, 248, 0.4);\r\n}\r\n\r\n/* Styled Select Input */\r\n.select-shell {\r\n  position: relative;\r\n}\r\n\r\n.contact-select {\r\n  width: 100%;\r\n  color: #fff;\r\n  background: rgba(6, 15, 34, 0.88);\r\n  border: 1px solid rgba(255, 255, 255, 0.1);\r\n  padding: 10.5px 30px 10.5px 36px;\r\n  border-radius: var(--r-sm);\r\n  outline: none;\r\n  font: 13.5px/1.3 var(--sans);\r\n  appearance: none;\r\n  -webkit-appearance: none;\r\n  cursor: pointer;\r\n  transition: border-color 0.25s, box-shadow 0.25s;\r\n}\r\n\r\n.contact-select:focus {\r\n  border-color: #38bdf8;\r\n  box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.18);\r\n}\r\n\r\n.contact-select option {\r\n  background: #09152e;\r\n  color: #fff;\r\n  padding: 8px;\r\n}\r\n\r\n.select-chevron {\r\n  position: absolute;\r\n  right: 12px;\r\n  color: var(--text-3);\r\n  font-size: 11px;\r\n  pointer-events: none;\r\n}\r\n\r\n/* Textarea Shell */\r\n.textarea-shell {\r\n  align-items: flex-start;\r\n}\r\n\r\n.textarea-glyph {\r\n  top: 11px;\r\n}\r\n\r\n.textarea-shell textarea {\r\n  width: 100%;\r\n  color: #fff;\r\n  background: rgba(6, 15, 34, 0.88);\r\n  border: 1px solid rgba(255, 255, 255, 0.1);\r\n  padding: 10px 14px 10px 36px;\r\n  border-radius: var(--r-sm);\r\n  resize: vertical;\r\n  min-height: 80px;\r\n  outline: none;\r\n  font: 13.5px/1.5 var(--sans);\r\n  transition: border-color 0.25s, box-shadow 0.25s, background 0.25s;\r\n}\r\n\r\n.textarea-shell textarea:focus {\r\n  border-color: #38bdf8;\r\n  background: rgba(8, 20, 44, 0.98);\r\n  box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.18), 0 0 16px rgba(56, 189, 248, 0.12);\r\n}\r\n\r\n.textarea-shell:focus-within .textarea-glyph {\r\n  color: #38bdf8;\r\n}\r\n\r\n.textarea-shell textarea.is-invalid {\r\n  border-color: #f43f5e !important;\r\n  background: rgba(244, 63, 94, 0.06) !important;\r\n  box-shadow: 0 0 0 3px rgba(244, 63, 94, 0.18) !important;\r\n}\r\n\r\n.field-error {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n  font: 11px var(--mono);\r\n  color: #fb7185;\r\n  margin: 1px 0 0;\r\n}\r\n\r\n.field-error-icon {\r\n  color: #f43f5e;\r\n  font-size: 11px;\r\n}\r\n\r\n/* Error Banner */\r\n.cn-error-banner {\r\n  background: rgba(244, 63, 94, 0.12);\r\n  border: 1px solid rgba(244, 63, 94, 0.38);\r\n  border-radius: var(--r-sm);\r\n  padding: 10px 12px;\r\n  display: grid;\r\n  gap: 8px;\r\n}\r\n\r\n.cn-error-header {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font: 12px var(--sans);\r\n  color: #fecdd3;\r\n  line-height: 1.4;\r\n}\r\n\r\n.cn-error-icon {\r\n  color: #f43f5e;\r\n  font-size: 13px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.cn-error-actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n\r\n.cn-mailto-fallback-btn {\r\n  padding: 6px 12px;\r\n  font: 600 11px var(--mono);\r\n  background: rgba(244, 63, 94, 0.22);\r\n  border: 1px solid rgba(244, 63, 94, 0.45);\r\n  border-radius: 4px;\r\n  color: #fff;\r\n  text-decoration: none;\r\n  transition: background 0.2s, border-color 0.2s;\r\n  display: inline-flex;\r\n  align-items: center;\r\n}\r\n\r\n.cn-mailto-fallback-btn:hover {\r\n  background: rgba(244, 63, 94, 0.38);\r\n  border-color: rgba(244, 63, 94, 0.7);\r\n}\r\n\r\n.cn-retry-btn {\r\n  padding: 6px 12px;\r\n  font: 600 11px var(--mono);\r\n  background: rgba(255, 255, 255, 0.08);\r\n  border: 1px solid var(--border-2);\r\n  border-radius: 4px;\r\n  color: var(--text-2);\r\n  cursor: pointer;\r\n  transition: background 0.2s, color 0.2s;\r\n}\r\n\r\n.cn-retry-btn:hover {\r\n  background: rgba(255, 255, 255, 0.15);\r\n  color: #fff;\r\n}\r\n\r\n/* Submit Action Button */\r\n.terminal-submit-btn {\r\n  width: 100%;\r\n  height: 48px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 10px;\r\n  font: 700 13px/1 var(--mono);\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n  border-radius: var(--r-sm);\r\n  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);\r\n  color: #fff;\r\n  border: none;\r\n  box-shadow: 0 4px 18px rgba(37, 99, 235, 0.4), 0 0 28px rgba(56, 189, 248, 0.18);\r\n  transition: all 0.25s ease;\r\n  position: relative;\r\n  overflow: hidden;\r\n  cursor: pointer;\r\n}\r\n\r\n.terminal-submit-btn:hover:not(:disabled) {\r\n  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 8px 26px rgba(37, 99, 235, 0.55), 0 0 34px rgba(56, 189, 248, 0.3);\r\n}\r\n\r\n.terminal-submit-btn:disabled {\r\n  opacity: 0.75;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.cn-spinner {\r\n  width: 15px;\r\n  height: 15px;\r\n  border: 2px solid rgba(255, 255, 255, 0.35);\r\n  border-top-color: #fff;\r\n  border-radius: 50%;\r\n  animation: cn-spin 0.7s linear infinite;\r\n  display: inline-block;\r\n  margin-right: 6px;\r\n}\r\n\r\n/* Form Footer Note */\r\n.contact-form-footer {\r\n  padding-top: 10px;\r\n  border-top: 1px solid rgba(255, 255, 255, 0.06);\r\n}\r\n\r\n.cff-note {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n  font-size: 11px;\r\n  color: var(--text-3);\r\n  line-height: 1.4;\r\n}\r\n\r\n.cff-dot {\r\n  width: 5px;\r\n  height: 5px;\r\n  border-radius: 50%;\r\n  background: #38bdf8;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.cff-note strong {\r\n  color: #cbd5e1;\r\n}\r\n\r\n/* ── Success Confirmation Receipt Card ──────────────────────── */\r\n.contact-receipt-card {\r\n  position: relative;\r\n  z-index: 1;\r\n  background: linear-gradient(155deg, rgba(10, 24, 52, 0.95) 0%, rgba(5, 12, 28, 0.98) 100%);\r\n  border: 1px solid rgba(16, 185, 129, 0.4);\r\n  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 35px rgba(16, 185, 129, 0.15);\r\n  border-radius: var(--r-lg);\r\n  padding: 28px 24px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  text-align: center;\r\n  height: 100%;\r\n  animation: cn-card-appear 0.4s cubic-bezier(0.16, 1, 0.3, 1);\r\n  overflow: hidden;\r\n}\r\n\r\n.receipt-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  width: 100%;\r\n  padding-bottom: 14px;\r\n  border-bottom: 1px dashed rgba(255, 255, 255, 0.12);\r\n  margin-bottom: 14px;\r\n}\r\n\r\n.receipt-badge-pill {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 3px 10px;\r\n  border-radius: 999px;\r\n  background: rgba(16, 185, 129, 0.14);\r\n  border: 1px solid rgba(16, 185, 129, 0.35);\r\n  font: 700 8.5px var(--mono);\r\n  color: #34d399;\r\n  letter-spacing: 0.14em;\r\n}\r\n\r\n.receipt-pulse-dot {\r\n  width: 5px;\r\n  height: 5px;\r\n  border-radius: 50%;\r\n  background: #10b981;\r\n  box-shadow: 0 0 6px #10b981;\r\n}\r\n\r\n.receipt-hash {\r\n  font: 700 9.5px var(--mono);\r\n  letter-spacing: 0.12em;\r\n  color: var(--text-3);\r\n}\r\n\r\n.receipt-icon-wrap {\r\n  position: relative;\r\n  width: 60px;\r\n  height: 60px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.receipt-icon-ring {\r\n  position: absolute;\r\n  inset: 0;\r\n  border-radius: 50%;\r\n  border: 2px dashed rgba(16, 185, 129, 0.35);\r\n  animation: receipt-spin-slow 20s linear infinite;\r\n}\r\n\r\n@keyframes receipt-spin-slow {\r\n  to { transform: rotate(360deg); }\r\n}\r\n\r\n.receipt-icon-core {\r\n  width: 48px;\r\n  height: 48px;\r\n  border-radius: 50%;\r\n  background: radial-gradient(circle, rgba(16, 185, 129, 0.3) 0%, rgba(6, 20, 42, 0.8) 80%);\r\n  border: 1px solid rgba(16, 185, 129, 0.55);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: #34d399;\r\n  box-shadow: 0 0 24px rgba(16, 185, 129, 0.3);\r\n}\r\n\r\n.contact-receipt-card h3 {\r\n  font-size: 20px;\r\n  font-weight: 700;\r\n  color: #fff;\r\n  margin: 0 0 6px;\r\n}\r\n\r\n.receipt-lead {\r\n  color: var(--text-2);\r\n  font-size: 13px;\r\n  line-height: 1.55;\r\n  max-width: 420px;\r\n  margin: 0 0 14px;\r\n}\r\n\r\n.receipt-lead strong {\r\n  color: #38bdf8;\r\n}\r\n\r\n/* Receipt Summary Table */\r\n.receipt-table {\r\n  width: 100%;\r\n  background: rgba(4, 9, 22, 0.8);\r\n  border: 1px solid rgba(255, 255, 255, 0.08);\r\n  border-radius: var(--r);\r\n  padding: 12px 16px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  text-align: left;\r\n  margin-bottom: 14px;\r\n}\r\n\r\n.receipt-row {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  gap: 12px;\r\n  font-size: 12px;\r\n}\r\n\r\n.r-label {\r\n  color: var(--text-3);\r\n  font-family: var(--mono);\r\n  font-size: 10.5px;\r\n  letter-spacing: 0.04em;\r\n}\r\n\r\n.r-val {\r\n  color: var(--text);\r\n  font-weight: 500;\r\n  word-break: break-all;\r\n  text-align: right;\r\n}\r\n\r\n.r-val strong {\r\n  color: #fff;\r\n}\r\n\r\n.highlight-topic {\r\n  color: #38bdf8 !important;\r\n  font-weight: 600;\r\n}\r\n\r\n.r-dest-badge {\r\n  font-family: var(--mono);\r\n  font-size: 10.5px;\r\n  color: #34d399 !important;\r\n  background: rgba(16, 185, 129, 0.12);\r\n  padding: 2px 8px;\r\n  border-radius: 4px;\r\n  border: 1px solid rgba(16, 185, 129, 0.25);\r\n}\r\n\r\n.receipt-dest-row {\r\n  padding-top: 6px;\r\n  border-top: 1px solid rgba(255, 255, 255, 0.06);\r\n}\r\n\r\n/* Fast-Track Card */\r\n.receipt-fasttrack-card {\r\n  width: 100%;\r\n  background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(6, 20, 42, 0.9) 100%);\r\n  border: 1px solid rgba(16, 185, 129, 0.35);\r\n  border-radius: var(--r);\r\n  padding: 12px 16px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  flex-wrap: wrap;\r\n  gap: 12px;\r\n  text-align: left;\r\n  margin-bottom: 14px;\r\n}\r\n\r\n.rft-content strong {\r\n  display: block;\r\n  font-size: 13px;\r\n  color: #fff;\r\n  margin-bottom: 2px;\r\n}\r\n\r\n.rft-content p {\r\n  font-size: 11.5px;\r\n  color: var(--text-2);\r\n  margin: 0;\r\n  line-height: 1.4;\r\n  max-width: 280px;\r\n}\r\n\r\n.rft-btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n  padding: 9px 16px;\r\n  font: 700 11.5px var(--mono);\r\n  letter-spacing: 0.06em;\r\n  background: #10b981;\r\n  color: #fff;\r\n  border-radius: var(--r-sm);\r\n  text-decoration: none;\r\n  box-shadow: 0 4px 14px rgba(16, 185, 129, 0.38);\r\n  transition: all 0.2s ease;\r\n  white-space: nowrap;\r\n}\r\n\r\n.rft-btn:hover {\r\n  background: #059669;\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 6px 20px rgba(16, 185, 129, 0.48);\r\n}\r\n\r\n.receipt-reset-btn {\r\n  justify-content: center;\r\n  padding: 9px 20px;\r\n  font-size: 12px;\r\n}\r\n\r\n/* ══════════════════════════════════════════════════════════════\r\n   FOOTER\r\n   ══════════════════════════════════════════════════════════════ */\r\nfooter {\r\n  background: var(--bg); border-top: 1px solid var(--border);\r\n  display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;\r\n  gap: 16px; padding: 26px var(--px); font-size: 11px; color: var(--text-3);\r\n}\r\nfooter nav { display: flex; gap: 18px; flex-wrap: wrap; }\r\nfooter nav a { transition: color .2s; }\r\nfooter nav a:hover { color: var(--blue-lt); }\r\nfooter p { margin: 0; }\r\n\r\n/* Mobile sticky CTA */\r\n.mobile-cta {\r\n  display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 40;\r\n  padding: 10px 16px 14px;\r\n  background: linear-gradient(to top, var(--bg) 55%, transparent);\r\n}\r\n.mobile-cta .button { width: 100%; justify-content: center; }\r\n\r\n/* ══════════════════════════════════════════════════════════════\r\n   CART DRAWER\r\n   ══════════════════════════════════════════════════════════════ */\r\n.cart-overlay {\r\n  position: fixed; inset: 0; z-index: 190;\r\n  background: rgba(3,6,15,.8); backdrop-filter: blur(4px);\r\n  opacity: 0; pointer-events: none; transition: opacity .35s;\r\n}\r\n.cart-overlay.open { opacity: 1; pointer-events: auto; }\r\n\r\n.cart-drawer {\r\n  position: fixed; top: 0; right: 0; z-index: 195;\r\n  width: min(460px, 100vw); height: 100dvh;\r\n  background: var(--bg-2); border-left: 1px solid var(--border);\r\n  box-shadow: -20px 0 60px rgba(0,0,0,.5);\r\n  transform: translateX(100%); transition: transform .5s cubic-bezier(.2,.8,.25,1);\r\n  display: flex; flex-direction: column;\r\n}\r\n.cart-drawer.open { transform: translateX(0); }\r\n\r\n.cart-head {\r\n  display: flex; justify-content: space-between; align-items: flex-start;\r\n  padding: 24px 24px 18px; border-bottom: 1px solid var(--border);\r\n  background: var(--bg-2); position: sticky; top: 0; z-index: 10;\r\n}\r\n.cart-head h3 { font-size: 26px; font-weight: 700; letter-spacing: -.06em; margin-top: 6px; }\r\n.cart-head sup { color: var(--blue-lt); font: 11px var(--mono); }\r\n.cart-close-btn {\r\n  display: grid; place-items: center; width: 40px; aspect-ratio: 1;\r\n  color: var(--text); background: rgba(255,255,255,.05); border: 1px solid var(--border-2);\r\n  border-radius: 50%; transition: all .2s; flex-shrink: 0;\r\n}\r\n.cart-close-btn:hover { color: var(--blue-lt); border-color: var(--blue-mid); background: var(--glass); }\r\n.cart-close-btn svg { width: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }\r\n\r\n.cart-items-scroll {\r\n  flex: 1; overflow-y: auto; padding: 0 24px 24px;\r\n  display: flex; flex-direction: column;\r\n}\r\n\r\n.cart-items { display: flex; flex-direction: column; gap: 0; flex: 1; }\r\n.cart-item {\r\n  display: flex; align-items: center; gap: 12px;\r\n  padding: 14px 0; border-bottom: 1px solid var(--border);\r\n}\r\n.cart-chip {\r\n  width: 40px; height: 40px; border-radius: 8px; flex-shrink: 0;\r\n  display: grid; place-items: center; font: 700 11px var(--mono); color: #fff;\r\n}\r\n.cart-chip.var-a { background: linear-gradient(135deg, #0e7490, #06B6D4); }\r\n.cart-chip.var-b { background: linear-gradient(135deg, #b45309, #F59E0B); }\r\n.cart-chip.var-c { background: linear-gradient(135deg, #1D4ED8, #3B82F6); }\r\n.cart-chip.var-d { background: linear-gradient(135deg, #6d28d9, #8B5CF6); }\r\n.cart-chip.var-e { background: linear-gradient(135deg, #065f46, #10B981); }\r\n.cart-chip.var-f { background: linear-gradient(135deg, #1D4ED8, #60A5FA); }\r\n\r\n.cart-item-info { flex: 1; min-width: 0; }\r\n.cart-item-info strong { display: block; font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\r\n.cart-item-info span   { display: block; font: 10px var(--mono); color: var(--text-3); margin-top: 2px; }\r\n\r\n.cart-item-right { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; flex-shrink: 0; }\r\n.cart-item-right b { font-size: 15px; font-weight: 700; letter-spacing: -.04em; }\r\n.cart-remove { font-size: 10px; color: var(--text-3); text-decoration: underline; transition: color .2s; background: none; border: none; cursor: pointer; }\r\n.cart-remove:hover { color: #F87171; }\r\n\r\n.cart-total {\r\n  display: flex; justify-content: space-between; align-items: center;\r\n  padding: 20px 0; font-size: 13px;\r\n}\r\n.cart-total strong { font-size: 22px; font-weight: 800; letter-spacing: -.06em; color: var(--blue-lt); }\r\n\r\n.cart-checkout { width: 100%; justify-content: center; }\r\n.cart-note { font-size: 10px; color: var(--text-3); text-align: center; margin-top: 10px; }\r\n\r\n.cart-empty {\r\n  flex: 1; display: flex; flex-direction: column;\r\n  align-items: center; justify-content: center; text-align: center; gap: 14px; padding: 40px 0;\r\n}\r\n.cart-empty-badge {\r\n  width: 68px; height: 68px; border-radius: 50%;\r\n  display: grid; place-items: center;\r\n  border: 1.5px solid rgba(56, 189, 248, 0.45);\r\n  box-shadow: 0 0 24px rgba(56, 189, 248, 0.25), 0 4px 16px rgba(0, 0, 0, 0.6);\r\n  background: #020617;\r\n  overflow: hidden;\r\n  animation: float 4s ease-in-out infinite;\r\n}\r\n.cart-empty-logo {\r\n  width: 100%; height: 100%;\r\n  object-fit: cover;\r\n}\r\n.cart-empty h4 { font-size: 22px; font-weight: 700; letter-spacing: -.05em; margin: 0; }\r\n.cart-empty p  { color: var(--text-2); font-size: 13px; line-height: 1.6; max-width: 240px; margin: 0; }\r\n\r\n/* Mobile-only close button at bottom of cart */\r\n.cart-close-mobile {\r\n  display: none; width: 100%; padding: 14px;\r\n  background: var(--glass); border: 1px solid var(--border-2); border-radius: var(--r);\r\n  color: var(--text-2); font: 600 13px var(--sans);\r\n  letter-spacing: .02em; margin-top: 20px; flex-shrink: 0;\r\n  transition: background .2s, color .2s;\r\n}\r\n.cart-close-mobile:hover { background: rgba(37,99,235,.15); color: var(--text); }\r\n\r\n/* ══════════════════════════════════════════════════════════════\r\n   GLOBAL KEYFRAMES\r\n   ══════════════════════════════════════════════════════════════ */\r\n@keyframes float     { 0%,100%{transform:translateY(0) rotate(-2.5deg)} 50%{transform:translateY(-12px) rotate(-2.5deg)} }\r\n@keyframes ring-pulse { 0%,100%{transform:scale(1);opacity:.5} 50%{transform:scale(1.08);opacity:.2} }\r\n\r\n/* ══════════════════════════════════════════════════════════════\r\n   RESPONSIVE — Tablet 1100px\r\n   ══════════════════════════════════════════════════════════════ */\r\n@media (max-width: 1100px) {\r\n  .testi-grid { grid-template-columns: 1fr 1fr; }\r\n  .testi-card:nth-child(1) { grid-row: auto; }\r\n  .video-grid { grid-template-columns: 1fr 1fr; }\r\n  .plans-grid { grid-template-columns: 1fr; gap: 16px; max-width: 480px; }\r\n  .plan-popular { transform: scale(1); }\r\n  .plan-popular:hover { transform: translateY(-8px); }\r\n  .plans-section { padding: var(--py) var(--px); }\r\n}\r\n\r\n/* ══════════════════════════════════════════════════════════════\r\n   RESPONSIVE — Mobile 850px\r\n   ══════════════════════════════════════════════════════════════ */\r\n@media (max-width: 850px) {\r\n  :root { --px: clamp(14px, 5vw, 28px); --py: clamp(60px, 8vw, 100px); }\r\n\r\n  /* Header */\r\n  .site-header { padding: 0 var(--px); }\r\n  .nav {\r\n    display: flex; flex-direction: column; gap: 0;\r\n    position: absolute; top: 72px; left: 12px; right: 12px;\r\n    background: rgba(6,14,29,.96); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);\r\n    border: 1px solid var(--border-2); border-radius: var(--r-lg);\r\n    box-shadow: 0 20px 50px rgba(0,0,0,.6); z-index: 99; overflow: hidden;\r\n    opacity: 0; pointer-events: none; transform: translateY(-10px);\r\n    transition: opacity .3s, transform .3s cubic-bezier(.2,.8,.25,1);\r\n  }\r\n  .nav.nav-open {\r\n    opacity: 1; pointer-events: auto; transform: translateY(0);\r\n  }\r\n  .nav a {\r\n    padding: 16px var(--px); border-bottom: 1px solid var(--border);\r\n    font-size: 15px; color: var(--text-2); transition: color .2s, background .2s;\r\n  }\r\n  .nav a:hover { background: rgba(255,255,255,.05); color: var(--text); }\r\n  .nav a:last-child { border: 0; }\r\n  .nav a.nav-active { color: var(--blue-lt); }\r\n  .btn-enroll { display: none; }\r\n  .cart-label { display: none; }\r\n  .menu-button { display: grid; }\r\n\r\n  /* Ann bar */\r\n  .ann-bar { height: 38px; padding: 0 4px 0 0; }\r\n  .ann-text { font-size: 11.5px; }\r\n\r\n  /* Hero */\r\n  .hero { padding-top: calc(38px + 66px + 32px); }\r\n  .hero-inner { grid-template-columns: 1fr; gap: 36px; }\r\n  .hero-countdown-wrap { max-width: 100%; }\r\n  .hero-countdown-card { padding: 22px 18px; }\r\n  .hero-scroll-hint { display: none; }\r\n\r\n  /* Sections */\r\n  .method-section, .curriculum-section, .testi-section,\r\n  .videos-section, .plans-section, .videos-section { padding: var(--py) var(--px); }\r\n\r\n  .principles-grid { grid-template-columns: 1fr; gap: 14px; }\r\n  .principles-grid .principle-card:nth-child(n) { margin-top: 0; }\r\n\r\n  .mentor-section { grid-template-columns: 1fr; }\r\n  .mentor-visual  { min-height: 440px; padding: 28px var(--px); padding-bottom: calc(28px + 58px); }\r\n  .mentor-content { padding: 50px var(--px); }\r\n  .mav-depth-stage { transform: scale(0.80); transform-origin: center center; overflow: visible; }\r\n  .mav-dp { width: 78px; height: 78px; }\r\n  .mav-center-portal { width: 190px; height: 190px; }\r\n\r\n  .faq-section { grid-template-columns: 1fr; gap: 30px; padding: var(--py) var(--px); }\r\n\r\n  .contact-section { grid-template-columns: 1fr; padding: var(--py) var(--px); gap: 36px; }\r\n  .contact-desk-column { height: auto; justify-content: flex-start; }\r\n  .contact-channels-list { flex: initial; height: auto; gap: 14px; margin-top: 20px; }\r\n  .channel-card { flex: initial; height: auto; min-height: auto; }\r\n  .terminal-fields-grid { grid-template-columns: 1fr; }\r\n  .terminal-exp-row { grid-template-columns: 1fr; }\r\n  .contact-trust-strip { justify-content: center; }\r\n\r\n  .testi-grid  { grid-template-columns: 1fr; }\r\n  .video-grid  { grid-template-columns: 1fr; }\r\n  .plans-grid  { max-width: none; }\r\n\r\n  .testi-cta   { justify-content: flex-start; }\r\n  footer { flex-direction: column; align-items: flex-start; gap: 14px; }\r\n  footer nav { flex-wrap: wrap; }\r\n\r\n  .mobile-cta { display: block; }\r\n\r\n  /* Cart: show mobile close btn */\r\n  .cart-close-mobile { display: block; }\r\n  .cart-head { padding: 16px 16px 14px; }\r\n  .cart-items-scroll { padding: 0 16px 20px; }\r\n}\r\n\r\n/* ══════════════════════════════════════════════════════════════\r\n   RESPONSIVE — Small Mobile 570px\r\n   ══════════════════════════════════════════════════════════════ */\r\n@media (max-width: 570px) {\r\n  h1 { font-size: 40px; }\r\n  h2 { font-size: 32px; }\r\n  .h1-em { font-size: 50px; }\r\n\r\n  .hero-actions { flex-direction: column; align-items: stretch; }\r\n  .hero-actions .button { justify-content: center; }\r\n  .hcd-grid { gap: 8px; }\r\n  .hcd-unit { padding: 12px 6px; }\r\n  .hcd-val { font-size: 28px; }\r\n  .hcd-lbl { font-size: 8px; }\r\n\r\n  .ann-text { display: none; }\r\n\r\n  .testi-grid { grid-template-columns: 1fr; }\r\n\r\n  /* Brand Mobile Sizing */\r\n  .brand { gap: 9px; }\r\n  .brand-logo { width: 34px; height: 34px; }\r\n  .brand-name { font-size: 16.5px; }\r\n  .brand-name em { font-size: 16.5px; }\r\n  .brand-sub { font-size: 7.5px; letter-spacing: 0.08em; }\r\n\r\n  .mentor-visual { min-height: 430px; padding: 24px 12px; padding-bottom: calc(24px + 58px); }\r\n  .mav-depth-stage { transform: scale(0.74); transform-origin: center center; overflow: visible; }\r\n  .mav-center-portal { width: 156px; height: 156px; }\r\n  .mav-dp { width: 84px; height: 84px; }\r\n  .plans-grid { grid-template-columns: 1fr; }\r\n\r\n  /* Contact Section Small Mobile */\r\n  .contact-desk-column { height: auto; justify-content: flex-start; }\r\n  .contact-channels-list { flex: initial; height: auto; gap: 12px; margin-top: 18px; }\r\n  .contact-form-row { grid-template-columns: 1fr; }\r\n  .channel-card {\r\n    flex: initial;\r\n    height: auto;\r\n    min-height: auto;\r\n    padding: 14px 16px;\r\n  }\r\n  .card-whatsapp {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 14px;\r\n  }\r\n  .card-whatsapp .channel-info {\r\n    flex: 1;\r\n    min-width: 0;\r\n  }\r\n  .card-whatsapp .channel-arrow {\r\n    margin-left: auto;\r\n    flex-shrink: 0;\r\n  }\r\n  .card-email {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    align-items: flex-start;\r\n    gap: 12px;\r\n    padding: 14px 16px;\r\n  }\r\n  .card-email .channel-icon-box {\r\n    flex-shrink: 0;\r\n    margin-top: 2px;\r\n  }\r\n  .card-email .channel-info {\r\n    flex: 1 1 calc(100% - 56px);\r\n    min-width: 0;\r\n  }\r\n  .card-email .channel-value.email-link {\r\n    font-size: 13.5px;\r\n    word-break: break-word;\r\n    display: block;\r\n    line-height: 1.35;\r\n    margin: 2px 0;\r\n  }\r\n  .card-email .channel-action-group {\r\n    width: 100%;\r\n    margin-top: 6px;\r\n    padding-top: 10px;\r\n    border-top: 1px solid rgba(255, 255, 255, 0.07);\r\n    display: flex;\r\n    justify-content: flex-end;\r\n    align-items: center;\r\n    gap: 8px;\r\n  }\r\n  .receipt-header { flex-direction: column; align-items: flex-start; gap: 8px; }\r\n  .receipt-fasttrack-card { flex-direction: column; align-items: stretch; text-align: center; }\r\n  .receipt-fasttrack-card .rft-btn { justify-content: center; width: 100%; }\r\n}\r\n\r\n@media (max-width: 440px) {\r\n  .brand-logo { width: 32px; height: 32px; }\r\n  .brand-name { font-size: 15.5px; }\r\n  .brand-name em { font-size: 15.5px; }\r\n  .brand-sub { font-size: 7px; }\r\n\r\n  .mentor-visual { min-height: 410px; padding: 20px 8px; padding-bottom: calc(20px + 58px); }\r\n  .mav-depth-stage { transform: scale(0.68); transform-origin: center center; overflow: visible; }\r\n  .mav-center-portal { width: 146px; height: 146px; }\r\n  .mav-dp { width: 80px; height: 80px; }\r\n}\r\n\r\n@media (max-width: 360px) {\r\n  .brand { gap: 7px; }\r\n  .brand-logo { width: 30px; height: 30px; }\r\n  .brand-name { font-size: 14.5px; }\r\n  .brand-name em { font-size: 14.5px; }\r\n  .brand-sub { display: none; }\r\n\r\n  .mentor-visual { min-height: 380px; padding: 16px 4px; padding-bottom: calc(16px + 58px); }\r\n  .mav-depth-stage { transform: scale(0.62); transform-origin: center center; overflow: visible; }\r\n  .mav-center-portal { width: 132px; height: 132px; }\r\n  .mav-dp { width: 74px; height: 74px; }\r\n}\r\n\r\n/* ══════════════════════════════════════════════════════════════\r\n   STUDENT REVIEWS HUB — Unified Subcategory Navigation Bar\r\n   ══════════════════════════════════════════════════════════════ */\r\n.student-reviews-hub {\r\n  position: relative;\r\n  scroll-margin-top: 80px;\r\n}\r\n\r\n#student-payout,\r\n#student-stories,\r\n#student-videos {\r\n  scroll-margin-top: 80px;\r\n}\r\n\r\n.proof-hub-sticky-bar {\r\n  position: relative;\r\n  background: linear-gradient(180deg, rgba(8, 16, 36, 0.98) 0%, rgba(4, 9, 22, 0.96) 100%);\r\n  border-top: 1px solid rgba(56, 189, 248, 0.2);\r\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08);\r\n  padding: 18px var(--px);\r\n  backdrop-filter: blur(20px);\r\n  -webkit-backdrop-filter: blur(20px);\r\n  z-index: 20;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);\r\n}\r\n\r\n.proof-hub-bar-inner {\r\n  max-width: 1240px;\r\n  margin: 0 auto;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.proof-hub-title-group {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.proof-hub-badge {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n  font: 700 10.5px/1 var(--mono);\r\n  letter-spacing: 0.12em;\r\n  color: #38bdf8;\r\n  background: rgba(56, 189, 248, 0.12);\r\n  border: 1px solid rgba(56, 189, 248, 0.28);\r\n  padding: 6px 12px;\r\n  border-radius: 6px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.phb-dot {\r\n  width: 6px;\r\n  height: 6px;\r\n  border-radius: 50%;\r\n  background: #38bdf8;\r\n  box-shadow: 0 0 8px #38bdf8;\r\n}\r\n\r\n.proof-hub-stats-badge {\r\n  font: 700 10px var(--mono);\r\n  letter-spacing: 0.08em;\r\n  color: var(--text-3);\r\n  text-transform: uppercase;\r\n}\r\n\r\n.proof-subcategories-pill-bar {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.proof-subcat-pill {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 6px 13px;\r\n  border-radius: 6px;\r\n  background: rgba(255, 255, 255, 0.04);\r\n  border: 1px solid rgba(255, 255, 255, 0.09);\r\n  color: var(--text-2);\r\n  text-decoration: none;\r\n  font: 600 12px/1.2 var(--sans);\r\n  transition: all 0.22s ease;\r\n}\r\n\r\n.proof-subcat-pill:hover {\r\n  background: rgba(56, 189, 248, 0.14);\r\n  border-color: rgba(56, 189, 248, 0.4);\r\n  color: #fff;\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.psc-icon {\r\n  font-size: 11px;\r\n  color: #38bdf8;\r\n}\r\n\r\n.psc-num {\r\n  font: 700 10px var(--mono);\r\n  color: #38bdf8;\r\n}\r\n\r\n.psc-badge {\r\n  font: 700 8.5px var(--mono);\r\n  letter-spacing: 0.08em;\r\n  padding: 2px 5px;\r\n  border-radius: 4px;\r\n  background: rgba(255, 255, 255, 0.08);\r\n  color: var(--text-3);\r\n  text-transform: uppercase;\r\n}\r\n\r\n.proof-subcat-pill:hover .psc-badge {\r\n  background: rgba(56, 189, 248, 0.22);\r\n  color: #38bdf8;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .proof-hub-bar-inner {\r\n    flex-direction: column;\r\n    align-items: flex-start;\r\n    gap: 12px;\r\n  }\r\n  .proof-subcategories-pill-bar {\r\n    width: 100%;\r\n    display: grid;\r\n    grid-template-columns: repeat(3, 1fr);\r\n    gap: 6px;\r\n  }\r\n  .proof-subcat-pill {\r\n    padding: 7px 8px;\r\n    font-size: 11px;\r\n    justify-content: center;\r\n  }\r\n  .psc-badge {\r\n    display: none;\r\n  }\r\n}\r\n\r\n/* ════════════════════════════════════════════