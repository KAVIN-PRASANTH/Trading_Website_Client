const __vite__css = "/* ══════════════════════════════════════════════════════════════\n   STUDENT VIDEO TESTIMONIALS — 9:16 Instagram Reel 3D Orbit\n   ══════════════════════════════════════════════════════════════ */\n\n.student-videos-section {\n  position: relative;\n  background-color: var(--bg-1, #030816);\n  background-image:\n    radial-gradient(ellipse 65% 45% at 50% 15%, rgba(14, 165, 233, 0.08) 0%, transparent 65%),\n    radial-gradient(ellipse 50% 50% at 85% 85%, rgba(37, 99, 235, 0.09) 0%, transparent 60%),\n    linear-gradient(to bottom, rgba(4, 9, 24, 0.98) 0%, rgba(2, 6, 18, 0.99) 100%);\n  padding: clamp(24px, 3.5vh, 40px) var(--px, 20px);\n  border-top: 1px solid rgba(255, 255, 255, 0.06);\n  border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n  overflow: hidden;\n}\n\n/* Subtle Institutional Depth Grid */\n.student-videos-section::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background-image:\n    linear-gradient(rgba(56, 189, 248, 0.02) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(56, 189, 248, 0.02) 1px, transparent 1px);\n  background-size: 54px 54px;\n  pointer-events: none;\n  opacity: 0.8;\n}\n\n.sv-container {\n  max-width: 1440px;\n  margin: 0 auto;\n  position: relative;\n  z-index: 1;\n}\n\n/* Section Header */\n.sv-header {\n  text-align: center;\n  max-width: 660px;\n  margin: 0 auto clamp(12px, 2vh, 20px);\n}\n\n.sv-tag {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font: 700 10.5px/1 var(--mono, monospace);\n  letter-spacing: 0.14em;\n  color: #38bdf8;\n  background: rgba(56, 189, 248, 0.12);\n  border: 1px solid rgba(56, 189, 248, 0.28);\n  padding: 4px 10px;\n  border-radius: 999px;\n  text-transform: uppercase;\n  margin-bottom: 6px;\n}\n\n.sv-tag-dot {\n  width: 5px;\n  height: 5px;\n  border-radius: 50%;\n  background: #38bdf8;\n  box-shadow: 0 0 6px #38bdf8;\n  animation: sv-pulse 2s infinite ease-in-out;\n}\n\n@keyframes sv-pulse {\n  0%, 100% { transform: scale(1); opacity: 0.8; }\n  50% { transform: scale(1.3); opacity: 1; }\n}\n\n.sv-header h2 {\n  font-size: clamp(24px, 2.8vw, 36px);\n  line-height: 1.15;\n  letter-spacing: -0.03em;\n  margin-bottom: 6px;\n  color: #fff;\n}\n\n.sv-header h2 em {\n  font-style: italic;\n  font-family: var(--serif, Georgia, serif);\n  background: linear-gradient(135deg, #ffffff 30%, #38bdf8 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n\n.sv-lead {\n  font-size: 14px;\n  line-height: 1.5;\n  color: var(--text-2, #94a3b8);\n  margin: 0 auto;\n}\n\n/* ══════════════════════════════════════════════════════════════\n   ORBIT VIEWPORT & SPATIAL 3D STAGE (DESKTOP PROMINENT SHOWCASE)\n   ══════════════════════════════════════════════════════════════ */\n/* ══════════════════════════════════════════════════════════════\n   ORBIT VIEWPORT & SPATIAL 3D STAGE (DESKTOP PROMINENT SHOWCASE)\n   ══════════════════════════════════════════════════════════════ */\n.sv-orbit-viewport {\n  position: relative;\n  width: 100%;\n  height: clamp(450px, 52vh, 480px);\n  margin: 0 auto;\n  perspective: 1400px;\n  -webkit-perspective: 1400px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  user-select: none;\n  cursor: grab;\n  touch-action: pan-y;\n}\n\n.sv-orbit-viewport.is-dragging {\n  cursor: grabbing !important;\n}\n\n.sv-orbit-viewport.is-dragging * {\n  cursor: grabbing !important;\n  user-select: none !important;\n}\n\n/* Ambient Radial Lighting Behind Center Reel */\n.sv-orbit-backdrop-glow {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  width: 680px;\n  height: 680px;\n  border-radius: 50%;\n  background: radial-gradient(circle, rgba(37, 99, 235, 0.28) 0%, rgba(56, 189, 248, 0.1) 45%, transparent 70%);\n  pointer-events: none;\n  z-index: 0;\n  transition: opacity 0.5s ease;\n}\n\n.sv-orbit-viewport.is-interacting .sv-orbit-backdrop-glow {\n  opacity: 0.95;\n}\n\n/* Desktop Navigation Floating Arrows */\n.sv-nav-arrow {\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  width: 48px;\n  height: 48px;\n  border-radius: 50%;\n  background: rgba(6, 16, 38, 0.88);\n  border: 1px solid rgba(56, 189, 248, 0.32);\n  color: #fff;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  z-index: 60;\n  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.65), 0 0 18px rgba(37, 99, 235, 0.25);\n}\n\n.sv-nav-arrow:hover {\n  background: rgba(56, 189, 248, 0.25);\n  border-color: rgba(56, 189, 248, 0.75);\n  color: #38bdf8;\n  transform: translateY(-50%) scale(1.1);\n  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.8), 0 0 26px rgba(56, 189, 248, 0.45);\n}\n\n.sv-nav-prev {\n  left: clamp(16px, 3.5vw, 48px);\n}\n\n.sv-nav-next {\n  right: clamp(16px, 3.5vw, 48px);\n}\n\n/* Orbit 3D Scene */\n.sv-orbit-scene {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transform-style: preserve-3d;\n  -webkit-transform-style: preserve-3d;\n  z-index: 1;\n}\n\n/* ══════════════════════════════════════════════════════════════\n   INDIVIDUAL ORBIT VIDEO CARDS\n   ══════════════════════════════════════════════════════════════ */\n.sv-orbit-card {\n  position: absolute;\n  overflow: hidden;\n  cursor: pointer;\n  background: #020617;\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  outline: none;\n  transform-origin: center center;\n  transition:\n    transform 0.68s cubic-bezier(0.16, 1, 0.3, 1),\n    opacity 0.5s ease,\n    filter 0.5s ease,\n    border-color 0.35s ease,\n    box-shadow 0.4s ease;\n  will-change: transform, opacity;\n}\n\n.sv-card-inner {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n}\n\n/* Video Preview Surface */\n.sv-video-frame-wrap {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  background: #000;\n}\n\n.sv-video-preview {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n}\n\n.sv-preview-img {\n  image-rendering: auto;\n  pointer-events: none;\n  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n.sv-orbit-card:hover .sv-preview-img {\n  transform: scale(1.035);\n}\n\n/* Center Play Action on Active Card */\n.sv-card-play-action {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  z-index: 35;\n  pointer-events: auto;\n}\n\n.sv-hero-play-pulse-btn {\n  position: relative;\n  width: 72px;\n  height: 72px;\n  border-radius: 50%;\n  background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);\n  border: 2.5px solid rgba(255, 255, 255, 0.95);\n  color: #ffffff;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding-left: 5px;\n  cursor: pointer;\n  box-shadow:\n    0 0 35px rgba(56, 189, 248, 0.75),\n    0 10px 28px rgba(0, 0, 0, 0.65);\n  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, background 0.25s ease;\n}\n\n.sv-hero-play-pulse-btn:hover {\n  transform: scale(1.12);\n  background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);\n  box-shadow:\n    0 0 50px rgba(56, 189, 248, 0.95),\n    0 14px 34px rgba(0, 0, 0, 0.75);\n}\n\n.sv-hero-play-pulse-btn:active {\n  transform: scale(0.98);\n}\n\n.sv-hero-play-ring {\n  position: absolute;\n  inset: -8px;\n  border-radius: 50%;\n  border: 2px solid rgba(255, 255, 255, 0.45);\n  animation: sv-play-pulse 2s cubic-bezier(0.25, 1, 0.5, 1) infinite;\n  pointer-events: none;\n}\n\n@keyframes sv-play-pulse {\n  0% {\n    transform: scale(0.92);\n    opacity: 0.9;\n  }\n  100% {\n    transform: scale(1.45);\n    opacity: 0;\n  }\n}\n\n.sv-hero-play-hint {\n  display: inline-flex;\n  align-items: center;\n  padding: 5px 14px;\n  border-radius: 999px;\n  background: rgba(3, 8, 22, 0.9);\n  border: 1px solid rgba(255, 255, 255, 0.22);\n  color: #ffffff;\n  font: 700 11px var(--mono, monospace);\n  letter-spacing: 0.09em;\n  text-transform: uppercase;\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);\n  pointer-events: none;\n}\n\n\n/* Cinematic Gradient Scrim */\n.sv-card-scrim {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(\n    to bottom,\n    rgba(2, 6, 23, 0.05) 0%,\n    rgba(2, 6, 23, 0.18) 50%,\n    rgba(2, 6, 23, 0.8) 80%,\n    rgba(2, 6, 23, 0.96) 100%\n  );\n  pointer-events: none;\n  transition: opacity 0.3s ease;\n}\n\n/* ══════════════════════════════════════════════════════════════\n   SPATIAL 3D SLOTS (ACTIVE HERO CARD IS WIDE & PROPORTIONATE)\n   ══════════════════════════════════════════════════════════════ */\n\n/* Slot 0: Center Active Hero Reel — Wide, Contained Height, Zero Navbar Overlap */\n.sv-orbit-card.slot-0 {\n  height: 430px;\n  width: clamp(350px, 28vw, 380px);\n  aspect-ratio: auto;\n  transform: translate3d(0, 0, 80px);\n  border-radius: 22px;\n  border: 1.5px solid rgba(255, 255, 255, 0.22);\n  box-shadow:\n    0 25px 65px rgba(0, 0, 0, 0.95),\n    0 0 1px rgba(255, 255, 255, 0.25),\n    inset 0 1px 0 rgba(255, 255, 255, 0.18);\n  z-index: 40;\n  opacity: 1;\n  filter: none;\n  overflow: hidden;\n  background: #000;\n}\n\n.sv-orbit-card.slot-0:hover {\n  transform: translate3d(0, 0, 90px);\n  border-color: rgba(255, 255, 255, 0.42);\n  box-shadow:\n    0 30px 80px rgba(0, 0, 0, 0.98),\n    0 0 20px rgba(255, 255, 255, 0.08);\n}\n\n/* Slot 1: Right Near */\n.sv-orbit-card.slot-1 {\n  height: 320px;\n  width: 180px;\n  aspect-ratio: auto;\n  border-radius: 16px;\n  transform: translate3d(clamp(280px, 24vw, 320px), 15px, -50px) rotateY(-18deg);\n  z-index: 25;\n  opacity: 0.78;\n  filter: drop-shadow(0 15px 35px rgba(0, 0, 0, 0.75));\n}\n\n/* Slot 5: Left Near */\n.sv-orbit-card.slot-5 {\n  height: 320px;\n  width: 180px;\n  aspect-ratio: auto;\n  border-radius: 16px;\n  transform: translate3d(clamp(-320px, -24vw, -280px), 15px, -50px) rotateY(18deg);\n  z-index: 25;\n  opacity: 0.78;\n  filter: drop-shadow(0 15px 35px rgba(0, 0, 0, 0.75));\n}\n\n/* Slot 2: Right Far */\n.sv-orbit-card.slot-2 {\n  height: 250px;\n  width: 140px;\n  aspect-ratio: auto;\n  border-radius: 14px;\n  transform: translate3d(clamp(470px, 38vw, 520px), -5px, -110px) rotateY(-25deg);\n  z-index: 15;\n  opacity: 0.45;\n  filter: drop-shadow(0 15px 35px rgba(0, 0, 0, 0.75));\n}\n\n/* Slot 4: Left Far */\n.sv-orbit-card.slot-4 {\n  height: 250px;\n  width: 140px;\n  aspect-ratio: auto;\n  border-radius: 14px;\n  transform: translate3d(clamp(-520px, -38vw, -470px), -5px, -110px) rotateY(25deg);\n  z-index: 15;\n  opacity: 0.45;\n  filter: drop-shadow(0 15px 35px rgba(0, 0, 0, 0.75));\n}\n\n/* Slot 3: Top Zenith Far */\n.sv-orbit-card.slot-3 {\n  height: 200px;\n  width: 110px;\n  aspect-ratio: auto;\n  border-radius: 12px;\n  transform: translate3d(0, -75px, -200px) scale(0.65);\n  z-index: 10;\n  opacity: 0.18;\n  filter: blur(1px) drop-shadow(0 12px 25px rgba(0, 0, 0, 0.65));\n}\n\n/* Hover on Surrounding Cards */\n.sv-orbit-card.is-surrounding:hover {\n  opacity: 0.96;\n  border-color: rgba(255, 255, 255, 0.28);\n  box-shadow: 0 20px 45px rgba(0, 0, 0, 0.85);\n}\n\n/* Center card remains rock-solid */\n.sv-orbit-card.is-active {\n  animation: none !important;\n}\n\n/* ══════════════════════════════════════════════════════════════\n   CARD CAPTION & STUDENT IDENTITY (CLEAN, NO CLUTTER)\n   ══════════════════════════════════════════════════════════════ */\n.sv-card-caption {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  padding: 14px 18px;\n  background: linear-gradient(to top, rgba(0, 0, 0, 0.92) 0%, rgba(0, 0, 0, 0.4) 65%, transparent 100%);\n  z-index: 10;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  pointer-events: none;\n}\n\n.sv-caption-name {\n  font-size: 15.5px;\n  font-weight: 700;\n  color: #ffffff;\n  letter-spacing: 0.01em;\n  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);\n}\n\n.sv-caption-live-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  font: 700 9.5px/1 var(--mono, monospace);\n  color: #f1f5f9;\n  background: rgba(255, 255, 255, 0.08);\n  border: 1px solid rgba(255, 255, 255, 0.2);\n  padding: 3px 8px;\n  border-radius: 999px;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n}\n\n.sv-caption-live-dot {\n  width: 5px;\n  height: 5px;\n  border-radius: 50%;\n  background: #38bdf8;\n  box-shadow: 0 0 6px #38bdf8;\n  animation: sv-pulse 1.5s infinite ease-in-out;\n}\n\n.sv-orbit-card.is-surrounding .sv-caption-name {\n  font-size: 13px;\n  font-weight: 600;\n  color: rgba(255, 255, 255, 0.9);\n  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.85);\n}\n\n/* ══════════════════════════════════════════════════════════════\n   PAGINATION DOTS BAR\n   ══════════════════════════════════════════════════════════════ */\n.sv-pagination-bar {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  margin-top: clamp(16px, 2.5vh, 24px);\n  position: relative;\n  z-index: 10;\n}\n\n.sv-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.18);\n  border: none;\n  cursor: pointer;\n  padding: 0;\n  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n.sv-dot:hover {\n  background: rgba(56, 189, 248, 0.5);\n}\n\n.sv-dot.is-active {\n  width: 26px;\n  background: #38bdf8;\n  box-shadow: 0 0 12px rgba(56, 189, 248, 0.7);\n}\n\n/* ══════════════════════════════════════════════════════════════\n   CINEMATIC THEATER MODAL VIDEO PLAYER (FULL VIEW)\n   ══════════════════════════════════════════════════════════════ */\n\n.sv-modal-backdrop {\n  position: fixed !important;\n  inset: 0 !important;\n  width: 100vw !important;\n  height: 100vh !important;\n  height: 100dvh !important;\n  z-index: 99999999 !important;\n  background: rgba(2, 6, 18, 0.95) !important;\n  backdrop-filter: blur(28px) !important;\n  -webkit-backdrop-filter: blur(28px) !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  padding: 16px !important;\n  padding-top: max(16px, env(safe-area-inset-top)) !important;\n  padding-bottom: max(16px, env(safe-area-inset-bottom)) !important;\n  animation: sv-modal-fade-in 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;\n  box-sizing: border-box !important;\n}\n\n@keyframes sv-modal-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n.sv-modal-shell.sv-modal-reel {\n  position: relative !important;\n  width: min(420px, 94vw) !important;\n  max-height: 92vh !important;\n  max-height: 92dvh !important;\n  background: linear-gradient(170deg, rgba(8, 18, 42, 0.98) 0%, rgba(3, 8, 22, 0.99) 100%) !important;\n  border: 1px solid rgba(255, 255, 255, 0.18) !important;\n  border-radius: 20px !important;\n  overflow: hidden !important;\n  box-shadow: 0 30px 90px rgba(0, 0, 0, 0.98), 0 0 1px rgba(255, 255, 255, 0.25) !important;\n  display: flex !important;\n  flex-direction: column !important;\n  animation: sv-modal-scale-up 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;\n}\n\n@keyframes sv-modal-scale-up {\n  from { transform: scale(0.95) translateY(12px); opacity: 0; }\n  to { transform: scale(1) translateY(0); opacity: 1; }\n}\n\n.sv-modal-head {\n  display: flex !important;\n  align-items: center !important;\n  justify-content: space-between !important;\n  padding: 12px 16px !important;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;\n  background: rgba(4, 10, 26, 0.96) !important;\n  flex-shrink: 0 !important;\n  gap: 10px !important;\n}\n\n.sv-modal-back-btn {\n  display: inline-flex !important;\n  align-items: center !important;\n  gap: 6px !important;\n  padding: 6px 14px !important;\n  border-radius: 999px !important;\n  back