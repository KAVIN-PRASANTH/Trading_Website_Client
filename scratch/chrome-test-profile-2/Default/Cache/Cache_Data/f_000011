n);\n  box-shadow: 0 0 8px var(--cyan);\n  animation: live-pulse 1.8s infinite;\n}\n\n.fdeck-proof-btn-text {\n  color: #BAE6FD;\n}\n\n.fdeck-proof-arrow {\n  width: 13px;\n  height: 13px;\n  fill: none;\n  stroke: var(--cyan);\n  stroke-width: 2.4;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  transition: transform 0.22s ease;\n}\n\n.fdeck-proof-btn:hover {\n  background: linear-gradient(135deg, rgba(37, 99, 235, 0.35) 0%, rgba(6, 182, 212, 0.3) 100%);\n  border-color: var(--cyan);\n  color: #FFFFFF;\n  transform: scale(1.04);\n  box-shadow: 0 0 20px rgba(6, 182, 212, 0.4), 0 4px 12px rgba(0, 0, 0, 0.5);\n}\n\n.fdeck-proof-btn:hover .fdeck-proof-arrow {\n  transform: translate(2px, -2px);\n}\n\n.fdeck-proof-btn:active {\n  transform: scale(0.97);\n}\n\n/* ── CARD BACK (ORIGINAL PROOF SCREENSHOT) ── */\n.fdeck-face-back {\n  transform: rotateY(180deg);\n  z-index: 1;\n  background: #060e1d;\n  background-image:\n    radial-gradient(ellipse 90% 70% at 50% 0%, rgba(20, 42, 86, 0.4) 0%, transparent 70%),\n    linear-gradient(168deg, rgba(10, 20, 40, 0.98) 0%, rgba(4, 9, 18, 0.99) 100%);\n  border: 1px solid rgba(56, 189, 248, 0.35);\n  border-top: 1px solid rgba(147, 197, 253, 0.5);\n  box-shadow:\n    0 24px 48px -12px rgba(0, 0, 0, 0.8),\n    0 0 32px -4px rgba(6, 182, 212, 0.18),\n    inset 0 1px 0 rgba(255, 255, 255, 0.15);\n  padding: clamp(12px, 2vw, 16px);\n}\n\n.fdeck-back-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 8px;\n  flex-shrink: 0;\n}\n\n.fdeck-back-title-wrap {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.fdeck-back-names {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.fdeck-proof-tag {\n  font: 700 9px var(--mono);\n  letter-spacing: 0.14em;\n  color: #34D399;\n  background: rgba(16, 185, 129, 0.12);\n  border: 1px solid rgba(52, 211, 153, 0.35);\n  padding: 3px 8px;\n  border-radius: 4px;\n  text-transform: uppercase;\n}\n\n.fdeck-proof-student {\n  font: 600 13px var(--sans);\n  color: var(--text-2);\n}\n\n/* Multi-proof screenshot selector */\n.fdeck-multi-proof-selector {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n}\n\n.fdeck-proof-pill {\n  width: 22px;\n  height: 22px;\n  border-radius: 50%;\n  background: rgba(15, 23, 42, 0.85);\n  border: 1px solid var(--border-2);\n  color: var(--text-2);\n  font: 700 10px var(--mono);\n  display: grid;\n  place-items: center;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.fdeck-proof-pill.is-active {\n  background: var(--blue);\n  border-color: var(--blue-lt);\n  color: #FFFFFF;\n  box-shadow: 0 0 8px rgba(37, 99, 235, 0.5);\n}\n\n/* Proof Image Preview Container */\n.fdeck-back-preview {\n  flex: 1;\n  width: 100%;\n  min-height: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: #020612;\n  border: 1px solid rgba(59, 130, 246, 0.18);\n  border-radius: var(--r-sm);\n  overflow: hidden;\n  margin-bottom: 12px;\n  position: relative;\n}\n\n.fdeck-proof-img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  display: block;\n  border-radius: calc(var(--r-sm) - 1px);\n  background: #020612;\n}\n\n/* Back Footer Actions */\n.fdeck-back-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  flex-shrink: 0;\n}\n\n.fdeck-back-btn,\n.fdeck-view-full-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 7px 15px;\n  border-radius: 999px;\n  font: 700 10px var(--mono);\n  letter-spacing: 0.06em;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.fdeck-back-btn {\n  background: rgba(15, 23, 42, 0.8);\n  border: 1px solid var(--border-2);\n  color: var(--text-2);\n}\n\n.fdeck-back-btn:hover {\n  background: rgba(37, 99, 235, 0.22);\n  border-color: var(--blue-mid);\n  color: #FFFFFF;\n}\n\n.fdeck-view-full-btn {\n  background: rgba(6, 182, 212, 0.12);\n  border: 1px solid rgba(6, 182, 212, 0.4);\n  color: var(--cyan);\n}\n\n.fdeck-view-full-btn:hover {\n  background: var(--cyan);\n  color: #020617;\n  box-shadow: 0 0 14px rgba(6, 182, 212, 0.45);\n}\n\n.fdeck-btn-icon {\n  width: 12px;\n  height: 12px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2.2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/* ── HIGH-RESOLUTION PROOF LIGHTBOX MODAL ── */\n.fdeck-lightbox-overlay {\n  position: fixed !important;\n  inset: 0 !important;\n  z-index: 9999999 !important;\n  background: rgba(2, 6, 18, 0.95);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: clamp(14px, 3vw, 36px);\n  animation: fdeck-fade-in 0.22s ease-out;\n}\n\n/* Floating Viewport-Fixed Corner Exit Pill */\n.fdeck-lightbox-fixed-close {\n  position: fixed;\n  top: 18px;\n  right: 22px;\n  z-index: 10000002;\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 10px 18px;\n  background: rgba(15, 23, 42, 0.92);\n  border: 1px solid rgba(56, 189, 248, 0.45);\n  border-radius: 999px;\n  color: #FFFFFF;\n  font: 700 12px var(--mono);\n  letter-spacing: 0.08em;\n  cursor: pointer;\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.75), 0 0 20px rgba(56, 189, 248, 0.25);\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n.fdeck-lightbox-fixed-close:hover {\n  background: rgba(239, 68, 68, 0.25);\n  border-color: #EF4444;\n  color: #FFFFFF;\n  box-shadow: 0 10px 30px rgba(239, 68, 68, 0.45), 0 0 25px rgba(239, 68, 68, 0.35);\n  transform: translateY(-2px) scale(1.02);\n}\n\n.fdeck-lightbox-fixed-close .fdeck-lightbox-close-icon {\n  font-size: 13px;\n  font-weight: 800;\n  color: #38BDF8;\n  line-height: 1;\n}\n\n.fdeck-lightbox-fixed-close:hover .fdeck-lightbox-close-icon {\n  color: #EF4444;\n}\n\n.fdeck-lightbox-container {\n  position: relative;\n  max-width: 580px;\n  width: 100%;\n  max-height: calc(100vh - 44px);\n  display: flex;\n  flex-direction: column;\n  background: #07132a;\n  border: 1px solid rgba(56, 189, 248, 0.38);\n  border-radius: var(--r-lg);\n  box-shadow: 0 25px 80px rgba(0, 0, 0, 0.95), 0 0 40px rgba(6, 182, 212, 0.22);\n  overflow: hidden;\n  animation: fdeck-zoom-in 0.26s cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n.fdeck-lightbox-topbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 12px 18px;\n  border-bottom: 1px solid rgba(59, 130, 246, 0.2);\n  background: rgba(9, 21, 46, 0.96);\n  flex-shrink: 0;\n}\n\n.fdeck-lightbox-back-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 14px;\n  border-radius: 999px;\n  background: rgba(56, 189, 248, 0.1);\n  border: 1px solid rgba(56, 189, 248, 0.28);\n  color: #BAE6FD;\n  font: 700 11px var(--mono);\n  letter-spacing: 0.08em;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.fdeck-lightbox-back-btn:hover {\n  background: rgba(56, 189, 248, 0.22);\n  border-color: #38BDF8;\n  color: #FFFFFF;\n  transform: translateX(-2px);\n}\n\n.fdeck-lightbox-title {\n  font: 700 11px var(--mono);\n  letter-spacing: 0.12em;\n  color: var(--cyan);\n  text-transform: uppercase;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.fdeck-lightbox-close-btn {\n  width: 32px;\n  height: 32px;\n  border-radius: 50%;\n  background: rgba(255, 255, 255, 0.08);\n  border: 1px solid rgba(255, 255, 255, 0.15);\n  display: grid;\n  place-items: center;\n  color: #FFFFFF;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  flex-shrink: 0;\n}\n\n.fdeck-lightbox-close-btn svg {\n  width: 16px;\n  height: 16px;\n  stroke: currentColor;\n  stroke-width: 2.2;\n}\n\n.fdeck-lightbox-close-btn:hover {\n  background: rgba(239, 68, 68, 0.25);\n  border-color: #EF4444;\n  color: #EF4444;\n  transform: scale(1.08);\n}\n\n.fdeck-lightbox-body {\n  flex: 1 1 auto;\n  min-height: 0;\n  overflow-y: auto;\n  display: flex;\n  align-items: flex-start;\n  justify-content: center;\n  padding: 16px;\n  background: #020612;\n  overscroll-behavior: contain;\n}\n\n.fdeck-lightbox-img {\n  max-width: 100%;\n  height: auto;\n  max-height: calc(100vh - 190px);\n  object-fit: contain;\n  display: block;\n  border-radius: var(--r-sm);\n  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.7);\n}\n\n.fdeck-lightbox-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 12px 18px;\n  border-top: 1px solid rgba(59, 130, 246, 0.18);\n  background: rgba(9, 21, 46, 0.96);\n  flex-shrink: 0;\n  gap: 12px;\n}\n\n.fdeck-lightbox-footer-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 18px;\n  border-radius: 8px;\n  background: linear-gradient(135deg, rgba(37, 99, 235, 0.35), rgba(6, 182, 212, 0.35));\n  border: 1px solid rgba(56, 189, 248, 0.45);\n  color: #FFFFFF;\n  font: 700 11.5px var(--mono);\n  letter-spacing: 0.06em;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.fdeck-lightbox-footer-btn:hover {\n  background: linear-gradient(135deg, rgba(37, 99, 235, 0.65), rgba(6, 182, 212, 0.65));\n  border-color: #38BDF8;\n  box-shadow: 0 4px 18px rgba(56, 189, 248, 0.4);\n  transform: translateY(-1px);\n}\n\n.fdeck-lightbox-hint {\n  font: 500 11px var(--mono);\n  color: var(--text-3);\n  letter-spacing: 0.04em;\n}\n\n@media (max-width: 640px) {\n  .fdeck-lightbox-overlay {\n    padding: 8px;\n  }\n  .fdeck-lightbox-container {\n    max-height: 98vh;\n    border-radius: var(--r-md);\n  }\n  .fdeck-lightbox-fixed-close {\n    top: 10px;\n    right: 10px;\n    padding: 7px 12px;\n    font-size: 11px;\n  }\n  .fdeck-lightbox-topbar {\n    padding: 10px 12px;\n  }\n  .fdeck-lightbox-title {\n    font-size: 9.5px;\n  }\n  .fdeck-lightbox-img {\n    max-height: calc(100vh - 170px);\n  }\n  .fdeck-lightbox-footer {\n    padding: 10px 12px;\n    flex-direction: column;\n    align-items: stretch;\n    gap: 8px;\n  }\n  .fdeck-lightbox-footer-btn {\n    justify-content: center;\n  }\n  .fdeck-lightbox-hint {\n    text-align: center;\n    font-size: 10px;\n  }\n}\n\n@keyframes fdeck-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes fdeck-zoom-in {\n  from { opacity: 0; transform: scale(0.92); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n/* ══════════════════════════════════════════════════════════════\n   NAVIGATION CONTROLS & PROGRESS\n   ══════════════════════════════════════════════════════════════ */\n.fdeck-controls-wrap {\n  position: relative;\n  z-index: 3;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 16px;\n  margin-top: 32px;\n  width: 100%;\n}\n\n.fdeck-controls-row {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: clamp(14px, 3vw, 24px);\n}\n\n/* Accessible Arrow Navigation Buttons */\n.fdeck-nav-btn {\n  width: 48px;\n  height: 48px;\n  border-radius: 50%;\n  background: linear-gradient(145deg, rgba(16, 30, 60, 0.95) 0%, rgba(7, 15, 34, 0.98) 100%);\n  border: 1px solid rgba(56, 189, 248, 0.35);\n  box-shadow:\n    0 8px 24px -4px rgba(0, 0, 0, 0.65),\n    0 0 16px rgba(6, 182, 212, 0.2),\n    inset 0 1px 0 rgba(255, 255, 255, 0.22);\n  display: grid;\n  place-items: center;\n  color: #BAE6FD;\n  cursor: pointer;\n  transition:\n    transform 0.2s cubic-bezier(0.2, 0.8, 0.25, 1),\n    background 0.2s ease,\n    border-color 0.2s ease,\n    box-shadow 0.2s ease,\n    color 0.2s ease;\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n  /* Remove the ugly iOS/Android tap square */\n  -webkit-tap-highlight-color: transparent;\n  outline: none;\n  appearance: none;\n  -webkit-appearance: none;\n}\n\n.fdeck-nav-btn svg {\n  width: 19px;\n  height: 19px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2.2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  transition: transform 0.2s ease;\n  pointer-events: none;\n}\n\n/* Hover only on real pointer devices — never on mobile touch */\n@media (hover: hover) and (pointer: fine) {\n  .fdeck-nav-btn:hover {\n    background: linear-gradient(145deg, #1D4ED8 0%, #2563EB 50%, #0284C7 100%);\n    border-color: rgba(147, 197, 253, 0.85);\n    color: #ffffff;\n    transform: scale(1.12);\n    box-shadow:\n      0 12px 28px -4px rgba(0, 0, 0, 0.7),\n      0 0 28px rgba(6, 182, 212, 0.65),\n      inset 0 1px 0 rgba(255, 255, 255, 0.45);\n  }\n  .fdeck-nav-btn.prev:hover svg { transform: translateX(-3px); }\n  .fdeck-nav-btn.next:hover svg { transform: translateX(3px); }\n}\n\n/* Clean press feedback for both desktop and mobile */\n.fdeck-nav-btn:active {\n  transform: scale(0.92);\n  background: linear-gradient(145deg, #1E40AF 0%, #1D4ED8 100%);\n  border-color: rgba(96, 165, 250, 0.8);\n  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.6);\n  transition: transform 0.08s ease, background 0.08s ease;\n}\n\n.fdeck-nav-btn:focus-visible {\n  outline: 2px solid var(--cyan);\n  outline-offset: 3px;\n}\n\n\n/* Infinity Stream Controls Badge */\n.fdeck-counter-badge.fdeck-infinity-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 20px;\n  background: rgba(7, 15, 34, 0.88);\n  border: 1px solid rgba(56, 189, 248, 0.38);\n  border-radius: 999px;\n  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.1);\n  user-select: none;\n}\n\n.fdeck-counter-badge.fdeck-infinity-badge .fdeck-infinity-icon {\n  width: 18px;\n  height: 18px;\n  fill: none;\n  stroke: var(--cyan);\n  stroke-width: 2.2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  filter: drop-shadow(0 0 6px rgba(6, 182, 212, 0.65));\n  animation: fdeck-infinity-pulse 3s infinite ease-in-out;\n}\n\n.fdeck-infinity-text {\n  font: 700 11px var(--mono);\n  letter-spacing: 0.14em;\n  color: #BAE6FD;\n}\n\n@keyframes fdeck-infinity-pulse {\n  0%, 100% { transform: scale(1); filter: drop-shadow(0 0 5px rgba(6, 182, 212, 0.5)); }\n  50% { transform: scale(1.09); filter: drop-shadow(0 0 12px rgba(6, 182, 212, 0.9)); }\n}\n\n/* Pagination Indicator Dots */\n.fdeck-dots-group {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  max-width: min(500px, 92vw);\n  flex-wrap: wrap;\n}\n\n.fdeck-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 999px;\n  background: rgba(59, 130, 246, 0.2);\n  border: 1px solid rgba(59, 130, 246, 0.35);\n  cursor: pointer;\n  transition:\n    width 0.32s cubic-bezier(0.2, 0.8, 0.25, 1),\n    background 0.3s ease,\n    border-color 0.3s ease,\n    box-shadow 0.3s ease;\n  padding: 0;\n}\n\n.fdeck-dot:hover {\n  background: rgba(96, 165, 250, 0.4);\n  border-color: var(--blue-lt);\n}\n\n.fdeck-dot.is-active {\n  width: 24px;\n  background: linear-gradient(90deg, var(--blue), var(--cyan));\n  border-color: var(--cyan);\n  box-shadow: 0 0 10px rgba(6, 182, 212, 0.5);\n}\n\n.fdeck-dot:focus-visible {\n  outline: 2px solid var(--cyan);\n  outline-offset: 2px;\n}\n\n/* Secondary Controls Row (Dots + Autoplay Indicator) */\n.fdeck-secondary-controls {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 16px;\n  flex-wrap: wrap;\n}\n\n.fdeck-autoplay-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  padding: 5px 12px;\n  border-radius: 999px;\n  background: rgba(10, 20, 42, 0.85);\n  border: 1px solid rgba(59, 130, 246, 0.25);\n  color: var(--text-2);\n  font: 700 10.5px var(--mono);\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  cursor: pointer;\n  transition: all 0.25s cubic-bezier(0.2, 0.8, 0.25, 1);\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);\n  -webkit-tap-highlight-color: transparent;\n  outline: none;\n  -webkit-appearance: none;\n}\n\n.fdeck-autoplay-pill:hover {\n  background: rgba(37, 99, 235, 0.25);\n  border-color: rgba(96, 165, 250, 0.5);\n  color: #ffffff;\n  transform: translateY(-1px);\n}\n\n.fdeck-autoplay-pill.is-active {\n  color: #BAE6FD;\n  border-color: rgba(56, 189, 248, 0.5);\n  background: linear-gradient(135deg, rgba(14, 165, 233, 0.22