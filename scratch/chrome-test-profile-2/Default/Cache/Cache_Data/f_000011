rtant;\n  border: 1px solid rgba(56, 189, 248, 0.22) !important;\n  border-top: 1px solid rgba(147, 197, 253, 0.45) !important;\n  box-shadow:\n    0 24px 48px -12px rgba(0, 0, 0, 0.82),\n    0 10px 24px -6px rgba(2, 6, 23, 0.6),\n    0 0 28px -4px rgba(37, 99, 235, 0.18),\n    inset 0 1px 0 rgba(255, 255, 255, 0.14),\n    inset 0 -1px 0 rgba(0, 0, 0, 0.4) !important;\n}\n\n.fdeck-card.layer-active .fdeck-face-front {\n  border-color: rgba(56, 189, 248, 0.38) !important;\n  border-top-color: rgba(186, 230, 253, 0.65) !important;\n  box-shadow:\n    0 28px 56px -12px rgba(0, 0, 0, 0.88),\n    0 12px 28px -6px rgba(2, 6, 23, 0.7),\n    0 0 36px -2px rgba(37, 99, 235, 0.26),\n    inset 0 1px 0 rgba(255, 255, 255, 0.2),\n    inset 0 -1px 0 rgba(0, 0, 0, 0.5) !important;\n}\n\n.fdeck-card .fdeck-avatar-monogram {\n  background: linear-gradient(135deg, rgba(30, 58, 138, 0.6) 0%, rgba(15, 23, 42, 0.9) 100%) !important;\n  border-color: rgba(56, 189, 248, 0.35) !important;\n  color: #BAE6FD !important;\n}\n\n.fdeck-card .fdeck-inline-quote {\n  color: #38BDF8 !important;\n}\n\n.fdeck-card .fdeck-proof-btn {\n  background: linear-gradient(135deg, rgba(14, 25, 49, 0.95) 0%, rgba(6, 13, 27, 0.98) 100%) !important;\n  border-color: rgba(56, 189, 248, 0.4) !important;\n  color: #BAE6FD !important;\n}\n\n.fdeck-card .fdeck-proof-radar {\n  background: #06B6D4 !important;\n  box-shadow: 0 0 8px #06B6D4 !important;\n}\n\n.fdeck-card .fdeck-proof-btn-text {\n  color: #BAE6FD !important;\n}\n\n.fdeck-card .fdeck-header-badge {\n  color: #38BDF8 !important;\n  background: rgba(10, 20, 42, 0.85) !important;\n  border-color: rgba(56, 189, 248, 0.3) !important;\n}\n\n.fdeck-card .fdeck-badge-dot {\n  background: #06B6D4 !important;\n  box-shadow: 0 0 8px #06B6D4 !important;\n}\n\n\n/* ══════════════════════════════════════════════════════════════\n   ACCESSIBILITY & REDUCED MOTION\n   ══════════════════════════════════════════════════════════════ */\n@media (prefers-reduced-motion: reduc